<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Processo-cobaia para CHAOS-KILL-01: grava acessos e fica vivo até levar SIGKILL.
    Existe porque "não perde acesso após kill -9" só é demonstrável matando um processo
    de verdade — simular a queda dentro do próprio teste provaria outra coisa.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CrashProbe</AssemblyName>
    <RootNamespace>CrashProbe</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Access.Domain/Access.Domain.csproj" />
    <ProjectReference Include="../../src/Access.Infrastructure.SQLite/Access.Infrastructure.SQLite.csproj" />
    <!-- Coleta de bilhetes (Etapa A.9): o laço de verdade contra a catraca simulada. -->
    <ProjectReference Include="../../src/Edge.Worker/Edge.Worker.csproj" />
    <ProjectReference Include="../../src/Simulator/Simulator.csproj" />
  </ItemGroup>

</Project>
