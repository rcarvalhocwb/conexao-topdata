<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup.exe do Rayzer XAcess (Rayzer Serviços e Tecnologia): um arquivo só, que instala tudo.

  É um "bundle" do WiX (Burn) em volta do MSI. O MSI já traz o .NET embutido em cada
  componente (publicação self-contained), então não há pré-requisito de runtime para
  baixar nem versão para casar. Ao terminar, o botão "Abrir o painel" abre o Painel; sem
  configuração, ele oferece o Assistente, que confere o SDK da Topdata e grava catracas e
  nuvem.

  O que continua fora, de propósito:
  - a EasyInner.dll e o SDK da Topdata: são da Topdata e este repositório é público. O
    assistente localiza a DLL no computador (ou num pendrive) e a copia para o lugar certo;
  - o .NET Framework 3.5: é um recurso do Windows; o assistente o habilita com um clique.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="Rayzer XAcess"
          IconSourceFile="$(sys.SOURCEFILEDIR)..\..\src\Rayzer.Design\Marca\rayzer-xacess.ico"
          Manufacturer="Rayzer Serviços e Tecnologia"
          Version="$(var.Versao)"
          UpgradeCode="8b0c64a6-2f6b-4a3e-9d0a-6d2f3c1a9e41">

    <BootstrapperApplication>
      <!-- Sem licença a aceitar: é um sistema do próprio evento. -->
      <!-- Textos em português (tema-pt-BR.wxl): sem ele, o Setup inteiro fala inglês. -->
      <bal:WixStandardBootstrapperApplication LicenseUrl="" Theme="hyperlinkLicense"
                                              LocalizationFile="$(sys.SOURCEFILEDIR)tema-pt-BR.wxl"
                                              LogoFile="$(sys.SOURCEFILEDIR)..\..\src\Rayzer.Design\Marca\rayzer-xacess-64.png"
                                              ShowVersion="yes" />
    </BootstrapperApplication>

    <!--
      O botão "Abrir o painel" da última tela abre o Painel, que não pede administrador.
      Antes abria o assistente, que exige administrador, e o Setup (sem elevação) não
      conseguia abri-lo: o botão não fazia nada. Com a instalação ainda sem configuração, o
      painel mostra o botão "Abrir assistente de configuração", que pede a permissão.
    -->
    <Variable Name="LaunchTarget" Type="formatted" Value="[ProgramFiles64Folder]Rayzer\XAcess\Painel\Desktop.App.exe" />
    <Variable Name="LaunchWorkingFolder" Type="formatted" Value="[ProgramFiles64Folder]Rayzer\XAcess\Painel" />

    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
