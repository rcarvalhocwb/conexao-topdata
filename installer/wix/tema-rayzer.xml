<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema do Setup.exe do Rayzer XAcess.

  Parte do HyperlinkTheme.xml do WiX 6.0.2 (WixToolset.BootstrapperApplications.wixext,
  licença MS-RL), com os mesmos nomes de controle: o WixStdBA procura os botões pelo nome
  (InstallButton, LaunchButton…), e um nome trocado deixa o botão sem ação.

  O que muda:
  - a janela tem a proporção da arte da marca (16:9) e a arte inteira de fundo
    (fundo-setup.png, gerada por tools/gerar-fundo-do-setup.py), pintada pela própria janela
    (Theme/@ImageFile + Window/@SourceX/SourceY). NÃO usar ImageControl de fundo: ele fica
    por cima dos botões e escondeu o "Instalar" nas versões 0.1.77 e 0.1.78;
  - todo texto e todo botão ficam na faixa escura da direita, já desenhada na arte, para
    não cobrir a marca, o slogan nem a catraca;
  - o logo de 64 px sai: a marca já está na arte.

  Cores em BGR hexadecimal (formato do thmutil). Fonte sem Background = texto transparente
  sobre a arte.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil" ImageFile="fundo-setup.png">
    <!-- 0: botões. 1: título. 2: cabeçalho de página. 3: campos de edição. 4: texto corrido. 5: rodapé. -->
    <Font Id="0" Height="-13" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="1" Height="-28" Weight="700" Foreground="FFFFFF">Segoe UI</Font>
    <Font Id="2" Height="-19" Weight="600" Foreground="FFAA5A">Segoe UI</Font>
    <Font Id="3" Height="-13" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="4" Height="-13" Weight="400" Foreground="EDE3DA">Segoe UI</Font>
    <Font Id="5" Height="-11" Weight="400" Foreground="B09B8A">Segoe UI</Font>

    <!--
      SourceX/SourceY: o fundo é o recorte 0,0–820,461 de Theme/@ImageFile, pintado pela
      própria janela, por baixo de tudo. HexStyle explícito mantém a barra de título (sem
      ele, o thmutil faria a janela WS_POPUP).
    -->
    <Window Width="820" Height="461" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)" SourceX="0" SourceY="0">
        <Label X="470" Y="28" Width="-24" Height="38" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>
        <Label X="470" Y="-44" Width="-24" Height="16" FontId="5" Visible="yes" DisablePrefix="yes">#(loc.InstallVersion)</Label>

        <Page Name="Help">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="470" Y="116" Width="-24" Height="-60" FontId="4" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Loading">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>
        <Page Name="Install">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">#(loc.InstallHeader)</Label>
            <Label X="470" Y="116" Width="-24" Height="96" FontId="4" DisablePrefix="yes">#(loc.InstallMessage)</Label>
            <Hypertext Name="EulaHyperlink" X="470" Y="216" Width="-24" Height="40" TabStop="yes" FontId="4" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
            <Checkbox Name="EulaAcceptCheckbox" X="470" Y="-76" Width="-24" Height="17" TabStop="yes" FontId="4" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
            <Button Name="InstallUpdateButton" X="470" Y="-16" Width="120" Height="28" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="OptionsButton" X="-232" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0" VisibleCondition="NOT WixStdBASuppressOptionsUI">
                <Text>#(loc.InstallOptionsButton)</Text>
                <ChangePageAction Page="Options" />
            </Button>
            <Button Name="InstallButton" X="-128" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Options">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
            <Label X="470" Y="124" Width="-24" Height="18" FontId="4" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
            <Editbox Name="InstallFolder" X="470" Y="146" Width="-128" Height="24" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-24" Y="145" Width="96" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsBrowseButton)</Text>
                <BrowseDirectoryAction VariableName="InstallFolder" />
            </Button>
            <Button Name="OptionsOkButton" X="-128" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsOkButton)</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsCancelButton)</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="470" Y="124" Width="96" Height="18" FontId="4" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="570" Y="124" Width="-24" Height="18" FontId="4" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="470" Y="150" Width="-24" Height="16" />
            <Button Name="ProgressCancelButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>
        <Page Name="Modify">
            <Label X="470" Y="82" Width="-24" Height="56" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Button Name="ModifyUpdateButton" X="470" Y="-56" Width="-24" Height="28" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="RepairButton" X="-232" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-128" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Success">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="470" Y="116" Width="-24" Height="110" FontId="4" DisablePrefix="yes" VisibleCondition="WixBundleAction = 6">#(loc.SuccessInstallText)</Label>
            <Label X="470" Y="-96" Width="-24" Height="34" FontId="4" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
                <Text>#(loc.SuccessRestartText)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
            </Label>
            <Button Name="LaunchButton" X="-128" Y="-16" Width="120" Height="28" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
            <Button Name="SuccessRestartButton" X="-128" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="470" Y="82" Width="-24" Height="28" FontId="2" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="470" Y="116" Width="-24" Height="56" FontId="4" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="470" Y="176" Width="-24" Height="80" FontId="4" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="470" Y="-96" Width="-24" Height="34" FontId="4" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-128" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-24" Y="-16" Width="96" Height="28" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
