<?xml version="1.0" encoding="utf-8"?>
<!--
  Textos do Setup.exe em português do Brasil. Tradução do HyperlinkTheme.wxl do WiX 6
  (WixToolset.BootstrapperApplications.wixext), com os mesmos identificadores: um
  identificador que faltar aqui deixa o botão em branco. A tela "Arquivos em uso" é a
  que aparecia em inglês com o painel aberto.
-->
<WixLocalization Culture="pt-BR" Language="1046" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalação — [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Procurando atualizações" />
  <String Id="UpdateButton" Value="&amp;Atualizar para a versão [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Bem-vindo" />
  <String Id="InstallMessage" Value="Este assistente vai instalar o [WixBundleName] neste computador. Clique em Instalar para continuar ou em Cancelar para sair." />
  <String Id="InstallMessageOptions" Value="Este assistente vai instalar o [WixBundleName] neste computador. Clique em Instalar para continuar, em Opções para escolher a instalação ou em Cancelar para sair." />
  <String Id="InstallVersion" Value="Versão [WixBundleVersion] · Rayzer Serviços e Tecnologia" />
  <String Id="ConfirmCancelMessage" Value="Deseja mesmo cancelar a instalação?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versão anterior" />
  <String Id="HelpHeader" Value="Ajuda da instalação" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [pasta] - instala, repara, desinstala ou&#xA;   copia o instalador completo para a pasta. O padrão é instalar.&#xA;&#xA;/passive | /quiet - mostra só o progresso, sem perguntas, ou não mostra nada.&#xA;   Por padrão, mostra todas as telas e perguntas.&#xA;&#xA;/norestart   - não reinicia o computador. Por padrão, pergunta antes de reiniciar.&#xA;/log log.txt - grava o registro neste arquivo. Por padrão, o registro vai para %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Fechar" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;termos de licença&lt;/a&gt;." />
  <String Id="InstallAcceptCheckbox" Value="&amp;Concordo com os termos de licença" />
  <String Id="InstallOptionsButton" Value="&amp;Opções" />
  <String Id="InstallInstallButton" Value="&amp;Instalar" />
  <String Id="InstallCancelButton" Value="&amp;Cancelar" />
  <String Id="OptionsHeader" Value="Opções da instalação" />
  <String Id="OptionsLocationLabel" Value="Pasta de instalação:" />
  <String Id="OptionsBrowseButton" Value="&amp;Procurar" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="&amp;Cancelar" />
  <String Id="ProgressHeader" Value="Instalando" />
  <String Id="ProgressLabel" Value="Em andamento:" />
  <String Id="OverallProgressPackageText" Value="Preparando..." />
  <String Id="ProgressCancelButton" Value="&amp;Cancelar" />
  <String Id="ModifyHeader" Value="O [WixBundleName] já está instalado" />
  <String Id="ModifyRepairButton" Value="&amp;Reparar" />
  <String Id="ModifyUninstallButton" Value="&amp;Desinstalar" />
  <String Id="ModifyCancelButton" Value="&amp;Cancelar" />
  <String Id="SuccessHeader" Value="Concluído" />
  <String Id="SuccessCacheHeader" Value="Cópia concluída" />
  <String Id="SuccessInstallHeader" Value="Instalação concluída" />
  <String Id="SuccessLayoutHeader" Value="Cópia do instalador concluída" />
  <String Id="SuccessModifyHeader" Value="Alteração concluída" />
  <String Id="SuccessRepairHeader" Value="Reparo concluído" />
  <String Id="SuccessUninstallHeader" Value="Desinstalação concluída" />
  <String Id="SuccessUnsafeUninstallHeader" Value="Desinstalação concluída" />
  <String Id="SuccessInstallText" Value="O serviço das catracas inicia com o Windows, o firewall já está liberado para as catracas da rede local e o painel fica perto do relógio.&#xA;&#xA;Abra o painel e siga o assistente de configuração para cadastrar as catracas." />
  <String Id="SuccessLaunchButton" Value="&amp;Abrir o painel" />
  <String Id="SuccessRestartText" Value="É preciso reiniciar o computador antes de usar o sistema." />
  <String Id="SuccessUninstallRestartText" Value="É preciso reiniciar o computador para terminar a remoção." />
  <String Id="SuccessRestartButton" Value="&amp;Reiniciar" />
  <String Id="SuccessCloseButton" Value="&amp;Fechar" />
  <String Id="FailureHeader" Value="A instalação falhou" />
  <String Id="FailureCacheHeader" Value="A cópia falhou" />
  <String Id="FailureInstallHeader" Value="A instalação falhou" />
  <String Id="FailureLayoutHeader" Value="A cópia do instalador falhou" />
  <String Id="FailureModifyHeader" Value="A alteração falhou" />
  <String Id="FailureRepairHeader" Value="O reparo falhou" />
  <String Id="FailureUninstallHeader" Value="A desinstalação falhou" />
  <String Id="FailureUnsafeUninstallHeader" Value="A desinstalação falhou" />
  <String Id="FailureHyperlinkLogText" Value="Um ou mais problemas impediram a instalação. Corrija-os e tente de novo. Os detalhes estão no &lt;a href=&quot;#&quot;&gt;registro da instalação&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="É preciso reiniciar o computador para terminar de desfazer a instalação." />
  <String Id="FailureRestartButton" Value="&amp;Reiniciar" />
  <String Id="FailureCloseButton" Value="&amp;Fechar" />
  <String Id="FilesInUseTitle" Value="Programas abertos" />
  <String Id="FilesInUseLabel" Value="Estes programas estão abertos e usam arquivos que serão atualizados:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="&amp;Fechar os programas." />
  <String Id="FilesInUseCloseRadioButton" Value="&amp;Fechar os programas e abri-los de novo depois." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Não fechar. Será preciso reiniciar o computador." />
  <String Id="FilesInUseRetryButton" Value="&amp;Tentar de novo" />
  <String Id="FilesInUseIgnoreButton" Value="&amp;Ignorar" />
  <String Id="FilesInUseExitButton" Value="&amp;Sair" />
</WixLocalization>
