<Window x:Class="Desktop.App.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexão Topdata — Painel do evento"
        Height="600" Width="1000"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

  <!--
    Largura mínima abaixo de 1366x768, que é a resolução mínima suportada, para caber
    em tela de portaria. Nada de fonte fixa: o escalonamento do sistema manda.
  -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Estado geral: a primeira coisa que o operador lê. -->
    <Border Grid.Row="0" Padding="16" CornerRadius="4"
            BorderThickness="2"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
      <StackPanel>
        <TextBlock x:Name="TextoDoEstado"
                   FontSize="20"
                   FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="Estado da operação"
                   Text="Conectando ao serviço local…" />

        <!-- Detalhe técnico fica recolhido: o modo guiado não mostra jargão. -->
        <Expander Header="Detalhes técnicos" Margin="0,12,0,0">
          <TextBlock x:Name="TextoDoDetalhe"
                     FontFamily="Consolas"
                     AutomationProperties.Name="Detalhes técnicos"
                     Text="—" />
        </Expander>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
      <TextBlock x:Name="TextoDeResumo"
                 FontSize="14"
                 AutomationProperties.Name="Resumo da operação"
                 Text="—" />
    </StackPanel>

    <DataGrid Grid.Row="2"
              x:Name="GradeDeEquipamentos"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AutomationProperties.Name="Equipamentos"
              CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Catraca" Binding="{Binding Inner}" Width="90" />
        <DataGridTextColumn Header="Portão" Binding="{Binding NomeDoGate}" Width="*" />
        <DataGridTextColumn Header="Grupo" Binding="{Binding Worker}" Width="140" />
        <DataGridTextColumn Header="Porta" Binding="{Binding Porta}" Width="80" />
        <DataGridTextColumn Header="Situação" Binding="{Binding Estado}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
