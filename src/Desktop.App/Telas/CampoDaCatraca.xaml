<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design">
  <!--
    Um campo da configuração da catraca (Etapa A.6 do docs/35): rótulo e origem, "usar o padrão
    do evento", editor, erro no campo e selos. O mesmo desenho na Parametrização (abas) e no
    painel de cada peça do gêmeo (docs/33 §9): um campo só, as mesmas regras.
    O que aguarda confirmação (chave técnica desligada ou A_CONFIRMAR) aparece desabilitado,
    com o selo "Aguardando confirmação" e o motivo.
  -->
  <DataTemplate x:Key="Campo.Parametrizacao">
    <Border Padding="8,10,8,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Rayzer.Border.Subtle}">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource Rayzer.Type.Caption}"
                     Text="{Binding TextoDaOrigem}" />
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" TextWrapping="Wrap" Text="{Binding Rotulo}" />
        </DockPanel>
        <CheckBox Margin="0,4,0,4" IsChecked="{Binding Herda}" IsEnabled="{Binding Disponivel}"
                  AutomationProperties.Name="Usar o padrão do evento">
          <!-- Quebra a linha: na coluna estreita do gêmeo o texto do padrão não cabe numa só. -->
          <TextBlock TextWrapping="Wrap" Text="{Binding TextoHerdar}" />
        </CheckBox>
        <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Escolhida}" DisplayMemberPath="Nome"
                  IsEnabled="{Binding Editavel}" Visibility="{Binding EhLista, Converter={StaticResource BoolParaVisibilidade}}"
                  AutomationProperties.Name="{Binding Rotulo}" AutomationProperties.HelpText="{Binding Erro}">
          <ComboBox.ItemContainerStyle>
            <!-- Opção que aguarda confirmação: aparece, com o texto dizendo, e não pode ser escolhida. -->
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
              <Setter Property="IsEnabled" Value="{Binding Disponivel}" />
              <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
        <TextBox MaxLength="64" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editavel}"
                 Visibility="{Binding EhTexto, Converter={StaticResource BoolParaVisibilidade}}"
                 AutomationProperties.Name="{Binding Rotulo}" AutomationProperties.HelpText="{Binding Erro}" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Rayzer.Danger}" FontWeight="SemiBold"
                   Text="{Binding Erro}" Visibility="{Binding Erro, Converter={StaticResource VazioSome}}" />
        <ItemsControl ItemsSource="{Binding Selos}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,8,0,0">
                <rz:RayzerStatusPill HorizontalAlignment="Left" Tom="Atencao" Texto="Aguardando confirmação" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
