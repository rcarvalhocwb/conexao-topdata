<UserControl x:Class="Desktop.App.Telas.Acessos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Acessos">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Pagina.Titulo}" Text="Acessos" />
      <TextBlock Style="{StaticResource Pagina.Descricao}"
                 Text="Toda tentativa fica registrada, autorizada ou negada. Datas e horas no horário de Brasília; sem hora, vale o dia inteiro." />
    </StackPanel>

    <!-- Filtros: todos os campos com a mesma altura, alinhados pela base. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Rayzer.Card}" Margin="0,0,0,12" Padding="16,12,4,0">
      <WrapPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Catraca" />
          <TextBox Width="96" Text="{Binding Catraca, UpdateSourceTrigger=PropertyChanged}" ToolTip="Vazio = todas" AutomationProperties.Name="Catraca" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Resultado" />
          <ComboBox Width="140" ItemsSource="{Binding OpcoesDeResultado}" SelectedIndex="{Binding Resultado}" AutomationProperties.Name="Resultado" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Categoria" />
          <TextBox Width="140" Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Categoria" />
        </StackPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="De (data · hora)" />
          <StackPanel Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding Desde}" AutomationProperties.Name="De" />
            <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraDesde, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="hh:mm — vazio = começo do dia" AutomationProperties.Name="Hora inicial" />
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Até (data · hora)" />
          <StackPanel Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding Ate}" AutomationProperties.Name="Até" />
            <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraAte, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="hh:mm — vazio = fim do dia" AutomationProperties.Name="Hora final" />
          </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource Rayzer.Button.Primary}" VerticalAlignment="Bottom" Margin="{StaticResource Rayzer.Margin.Field}"
                Content="_Buscar" IsDefault="True" Command="{Binding Buscar}" />
      </WrapPanel>
    </Border>

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <Grid>
      <DataGrid ItemsSource="{Binding Linhas}" AutomationProperties.Name="Acessos encontrados">
        <DataGrid.Columns>
          <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="84" ElementStyle="{StaticResource Celula.Mono}" />
          <DataGridTextColumn Header="CATRACA" Binding="{Binding Inner}" Width="76" />
          <DataGridTemplateColumn Header="RESULTADO" Width="*" CellTemplate="{StaticResource Celula.Acesso}" />
          <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="120" />
          <DataGridTextColumn Header="GIROU" Binding="{Binding Girou, Converter={StaticResource SimOuTraco}}" Width="70" />
          <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource Celula.Mono}" />
        </DataGrid.Columns>
      </DataGrid>
      <rz:RayzerEmptyState Icone="{DynamicResource Rayzer.Icon.Search}" Titulo="Nenhum acesso para mostrar"
                           Texto="Ajuste os filtros e clique em Buscar. Sem filtro, aparecem os 500 mais recentes."
                           Visibility="{Binding Linhas, Converter={StaticResource ZeroParaVisivel}}" />
    </Grid>
  </DockPanel>
</UserControl>
