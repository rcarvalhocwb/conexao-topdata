<UserControl x:Class="Desktop.App.Telas.Usuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Usuários">
  <DockPanel>
    <rz:RayzerPageHeader DockPanel.Dock="Top" Titulo="Usuários e papéis"
                         Descricao="Quem entra no sistema e o que cada papel pode fazer. Usuário novo e senha redefinida trocam a senha no próximo acesso. O serviço confere a permissão em cada ação." />

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Usuários ===== -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Novo usuário" Command="{Binding NovoUsuario}" />
                <rz:RayzerSectionHeader Titulo="Usuários" />
              </DockPanel>
              <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSelecionado}" MaxHeight="240"
                        AutomationProperties.Name="Usuários do sistema">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*" />
                  <DataGridTextColumn Header="LOGIN" Binding="{Binding Login}" Width="110" ElementStyle="{StaticResource Celula.Mono}" />
                  <DataGridTextColumn Header="PAPÉIS" Binding="{Binding Papeis}" Width="130" />
                  <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding Situacao}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
              <rz:RayzerSectionHeader Titulo="{Binding TituloDoUsuario}" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome" />
              <TextBox Margin="0,4,0,10" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do usuário" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Login (letras sem acento, números, ponto, hífen)" />
              <TextBox Margin="0,4,0,10" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Login do usuário" />
              <StackPanel Visibility="{Binding CriandoUsuario, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Senha inicial (a pessoa troca no primeiro acesso)" />
                <TextBox Margin="0,4,0,10" Text="{Binding SenhaInicial, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Senha inicial" />
              </StackPanel>
              <CheckBox Margin="0,0,0,10" IsChecked="{Binding Ativo}" Content="Ativo (pode entrar)" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Papéis" />
              <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding PapeisDoUsuario}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Margin="0,2" IsChecked="{Binding Marcado}" Content="{Binding Nome}" ToolTip="{Binding Grupo}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Content="_Gravar usuário" Command="{Binding GravarUsuario}" />

              <Border Style="{StaticResource Rayzer.Divider}" Margin="0,16,0,12" />
              <StackPanel>
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Esqueceu a senha? Senha provisória (a pessoa troca no próximo acesso)" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBox Width="220" Text="{Binding SenhaProvisoria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Senha provisória" />
                  <Button Margin="8,0,0,0" Content="_Redefinir a senha" Command="{Binding RedefinirSenha}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Papéis ===== -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="Novo _papel" Command="{Binding NovoPapel}" />
                <rz:RayzerSectionHeader Titulo="Papéis" />
              </DockPanel>
              <DataGrid ItemsSource="{Binding Papeis}" SelectedItem="{Binding PapelSelecionado}" MaxHeight="200"
                        AutomationProperties.Name="Papéis">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="PAPEL" Binding="{Binding Nome}" Width="*" />
                  <DataGridTextColumn Header="ORIGEM" Binding="{Binding Origem}" Width="100" />
                  <DataGridTextColumn Header="PERMISSÕES" Binding="{Binding Resumo}" Width="130" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
              <rz:RayzerSectionHeader Titulo="{Binding TituloDoPapel}" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome do papel" />
              <TextBox Margin="0,4,0,10" Text="{Binding PapelNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do papel" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Para que serve" />
              <TextBox Margin="0,4,0,10" Text="{Binding PapelDescricao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição do papel" />
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="O que este papel pode fazer" />
              <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding PermissoesDoPapel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Margin="0,3" IsChecked="{Binding Marcado}">
                      <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding Grupo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Nome, Mode=OneWay}" />
                      </TextBlock>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Content="Gravar p_apel" Command="{Binding GravarPapel}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
