<UserControl x:Class="Desktop.App.Telas.Configuracoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             xmlns:vm="clr-namespace:Desktop.ViewModels;assembly=Desktop.ViewModels"
             AutomationProperties.Name="Configurações do evento">
  <!--
    Configurações do evento em seções fixas, sempre na mesma ordem (docs/57 §2):
    1 Evento · 2 Tipos de entrada · 3 Cartões da bilheteria · 4 Padrão das catracas ·
    5 O que ainda não dá para configurar (com o motivo) · 6 Avançado (só leitura).
    Cada seção salva sozinha: salvar o nome do evento não mexe nas catracas.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <rz:RayzerPageHeader Titulo="Configurações do evento"
                           Descricao="Seis seções, sempre nesta ordem: 1 Evento · 2 Tipos de entrada · 3 Cartões da bilheteria · 4 Padrão das catracas · 5 O que ainda não dá para configurar · 6 Avançado. Cada seção tem o próprio botão de salvar. O que é de uma catraca só fica em Configuração da catraca." />

      <rz:RayzerAlert Style="{StaticResource Pagina.Mensagem}" Margin="0,0,0,12" Titulo="{Binding Mensagem}"
                      Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

      <!-- 1. Evento -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="1 · Evento" />
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Nome, período e hora de corte. Datas e horas no horário de Brasília." />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome do evento (até 80 letras)" />
          <TextBox MaxLength="80" Text="{Binding NomeDoEvento, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do evento" />

          <WrapPanel Margin="0,12,0,0">
            <StackPanel Margin="0,0,24,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Começa em" />
              <StackPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding InicioDoEvento}" AutomationProperties.Name="Data de início do evento" />
                <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraDeInicio, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="HH:MM — vazio = começo do dia" AutomationProperties.Name="Hora de início do evento" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Termina em" />
              <StackPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding FimDoEvento}" AutomationProperties.Name="Data de fim do evento" />
                <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraDeFim, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="HH:MM — vazio = fim do dia" AutomationProperties.Name="Hora de fim do evento" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Hora de corte do dia" />
              <TextBox Width="72" HorizontalAlignment="Left" MaxLength="5" Text="{Binding HoraDeCorte, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Quando um dia de operação vira o seguinte nos relatórios (ex.: 06:00 para festas que passam da meia-noite)."
                       AutomationProperties.Name="Hora de corte do dia de operação" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                     Text="Hora de corte: quando um dia de operação vira o seguinte nos relatórios. Para festa que passa da meia-noite, use, por exemplo, 06:00." />

          <CheckBox Margin="0,12,0,0" IsChecked="{Binding RecusarForaDoPeriodo}"
                    Content="Recusar ingressos e cartões da bilheteria lidos fora do período do evento" />
          <TextBlock Margin="24,2,0,0" Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                     Text="A catraca nega com o motivo &quot;fora do período do evento&quot;. Pessoas credenciadas (equipe, fornecedores) não são afetadas: valem os horários delas." />

          <rz:RayzerStatusPill Margin="0,12,0,0" HorizontalAlignment="Left" Tom="Neutro" Texto="{Binding SituacaoDoPeriodo}"
                               AutomationProperties.Name="Situação do período agora" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap" Text="{Binding EventoAlterado}" />

          <ItemsControl ItemsSource="{Binding ProblemasDoEvento}" AutomationProperties.Name="Problemas do evento">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <rz:RayzerAlert Margin="0,8,0,0" Tom="Perigo" Titulo="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"
                  Content="Salvar o _evento" Command="{Binding SalvarEvento}" />
        </StackPanel>
      </Border>

      <!-- 2. Tipos de entrada -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Novo tipo" Command="{Binding NovoTipo}" />
            <rz:RayzerSectionHeader Titulo="2 · Tipos de entrada" />
          </DockPanel>
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="INTEIRA, MEIA, SOCIAL… Clique num tipo para mudar o nome, a ordem ou desativar. Desativado, a catraca nega todos os cartões dele." />
          <DataGrid ItemsSource="{Binding TiposDeEntrada}" SelectedItem="{Binding TipoSelecionado}" MaxHeight="220"
                    AutomationProperties.Name="Tipos de entrada">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource Celula.Mono}" />
              <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*" />
              <DataGridTextColumn Header="ORDEM" Binding="{Binding Ordem}" Width="80" />
              <DataGridTextColumn Header="ATIVO" Binding="{Binding Ativo, Converter={StaticResource SimOuTraco}}" Width="80" />
              <DataGridTextColumn Header="CARTÕES" Binding="{Binding EmUso}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
          <rz:RayzerEmptyState Icone="{DynamicResource Rayzer.Icon.List}" Titulo="Nenhum tipo cadastrado"
                               Texto="Os tipos aparecem aqui quando a carga de cartões ou o cadastro criam o primeiro, ou em Novo tipo."
                               Visibility="{Binding TiposDeEntrada, Converter={StaticResource ZeroParaVisivel}}" />

          <WrapPanel Margin="0,12,0,0">
            <StackPanel Margin="0,0,16,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Código (não muda depois)" />
              <TextBox Width="160" MaxLength="20" CharacterCasing="Upper" Text="{Binding CodigoDoTipo, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding TipoNovo}" AutomationProperties.Name="Código do tipo" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome que aparece" />
              <TextBox Width="240" MaxLength="40" Text="{Binding NomeDoTipo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do tipo" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Ordem" />
              <TextBox Width="80" MaxLength="4" Text="{Binding OrdemDoTipo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ordem do tipo" />
            </StackPanel>
            <CheckBox Margin="0,0,16,8" VerticalAlignment="Bottom" IsChecked="{Binding TipoAtivo}" Content="Ativo" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding ProblemasDoTipo}" AutomationProperties.Name="Problemas do tipo">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <rz:RayzerAlert Margin="0,8,0,0" Tom="Perigo" Titulo="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Content="Salvar o _tipo" Command="{Binding SalvarTipo}" />
        </StackPanel>
      </Border>

      <!-- 3. Cartões da bilheteria -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="3 · Cartões da bilheteria" />
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Regras dos cartões que a bilheteria entrega e a urna recolhe. Valem na próxima leitura, sem reiniciar nada." />
          <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Text="{Binding ResumoDaBilheteria}"
                     AutomationProperties.Name="Resumo dos cartões da bilheteria" />

          <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding PodeMudarBilheteria}">
            <StackPanel Margin="0,0,24,8">
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Minutos entre dois usos do mesmo cartão (0 a 120)" />
              <TextBox Width="90" HorizontalAlignment="Left" MaxLength="6" Text="{Binding IntervaloDeReuso, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Minutos entre usos do mesmo cartão" />
            </StackPanel>
            <CheckBox Margin="0,0,0,8" VerticalAlignment="Bottom" IsChecked="{Binding SomenteNaUrna}"
                      Content="Só vale na fenda da urna (no leitor da frente, a catraca pede a urna)" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                     Text="O intervalo impede que o mesmo cartão seja passado por cima da grade para quem está do lado de fora. Para carregar cartões já validados de um arquivo, use carregar-cartoes.ps1 (pasta de instalação), como administrador." />
          <ItemsControl ItemsSource="{Binding ProblemasDaBilheteria}" AutomationProperties.Name="Problemas da bilheteria">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <rz:RayzerAlert Margin="0,8,0,0" Tom="Perigo" Titulo="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                  Content="Salvar as regras dos _cartões" Command="{Binding SalvarBilheteria}" />
        </StackPanel>
      </Border>

      <!-- 4. Padrão das catracas -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="4 · Padrão das catracas" />
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Vale para toda catraca que não tiver um valor próprio em Configuração da catraca (lá, o valor da catraca vale mais). Depois de salvar, &quot;Aplicar agora nas catracas&quot; faz cada uma reconectar com a configuração nova (alguns segundos sem atender cada)." />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Mensagem no visor da catraca (até 32 letras)" />
          <TextBox MaxLength="32" Text="{Binding MensagemPadrao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mensagem do display" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Margin="0,16,0,6" Text="Segundos que a catraca fica liberada esperando o giro (1 a 50)" />
          <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding TempoDeAcionamento, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tempo de acionamento" />

          <CheckBox Margin="0,16,0,0" IsChecked="{Binding LeitorDaUrna}" Content="Leitor da urna ligado (o cartão da bilheteria entra pela fenda)" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Margin="0,16,0,6" Text="Leitor de ingressos" />
          <ComboBox Width="320" HorizontalAlignment="Left" ItemsSource="{x:Static vm:ConfiguracoesViewModel.TiposDeLeitor}"
                    DisplayMemberPath="Nome" SelectedItem="{Binding TipoDeLeitorEscolhido}" AutomationProperties.Name="Tipo de leitor" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                     Text="Use o leitor de QR Code (8). Troque para o de código de barras (5) só se o QR não for lido: isso ainda está sendo confirmado na bancada." />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Margin="0,16,0,6" Text="Segundos que a liberação espera o giro antes de subir para a nuvem" />
          <TextBox Width="120" HorizontalAlignment="Left" IsEnabled="{Binding NuvemLigada}"
                   Text="{Binding EsperaPeloGiro, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Espera pelo giro" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                     Text="Só com a nuvem ligada. Muda quando o serviço reiniciar." />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Margin="0,16,0,6" Text="Quem está mudando (fica registrado; vem do login)" />
          <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding Operador, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Operador" />

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource Rayzer.Button.Primary}" Content="_Salvar o padrão" IsDefault="True" Command="{Binding Salvar}" />
            <Button Style="{StaticResource Rayzer.Button.Ghost}" Margin="12,0,0,0" Content="_Aplicar agora nas catracas…"
                    Command="{Binding PrepararAplicacao}"
                    ToolTip="Cada catraca reconecta e recebe a configuração salva. Fica alguns segundos sem atender: prefira fora do pico." />
          </StackPanel>

          <!-- Segundo passo: a confirmação da aplicação em todas as catracas. -->
          <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{DynamicResource Rayzer.Radius.Md}"
                  Background="{DynamicResource Rayzer.Warning.Subtle}"
                  Visibility="{Binding ConfirmandoAplicacao, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Rayzer.Type.Body}" Text="{Binding TextoDaConfirmacaoDaAplicacao}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource Rayzer.Button.Primary}" Content="_Confirmar a aplicação" Command="{Binding AplicarAgora}" />
                <Button Style="{StaticResource Rayzer.Button.Ghost}" Content="Ca_ncelar" Margin="10,0,0,0" Command="{Binding CancelarAplicacao}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Problemas}" AutomationProperties.Name="Problemas">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <rz:RayzerAlert Margin="0,8,0,0" Tom="Perigo" Titulo="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 5. O que ainda não dá para configurar: desabilitado, com o motivo. Nada some. -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="5 · O que ainda não dá para configurar" />
          <ItemsControl ItemsSource="{x:Static vm:ConfiguracoesViewModel.SecoesBloqueadas}" AutomationProperties.Name="Seções aguardando confirmação">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,6,0,6">
                  <rz:RayzerStatusPill DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" Tom="Atencao" Texto="Aguardando" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource Rayzer.Type.Body}" FontWeight="SemiBold" Text="{Binding Titulo}" />
                    <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding Motivo}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 6. Avançado: as chaves técnicas, só leitura. -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="20,18" Margin="0,0,0,12">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="6 · Avançado (só leitura)" />
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Funções da catraca que ficam desligadas até o ensaio na bancada confirmar o que fazem. Não mudam por aqui: quem liga é o técnico, depois do ensaio indicado." />
          <DataGrid ItemsSource="{Binding ChavesTecnicas}" MaxHeight="320" AutomationProperties.Name="Chaves técnicas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="O QUE FAZ" Binding="{Binding Descricao}" Width="*" />
              <DataGridTextColumn Header="LIGADA" Binding="{Binding Ligada, Converter={StaticResource SimOuTraco}}" Width="90" />
              <DataGridTextColumn Header="LIBERA NO ENSAIO" Binding="{Binding LiberadaPor}" Width="200" />
              <DataGridTextColumn Header="CHAVE" Binding="{Binding Chave}" Width="250" ElementStyle="{StaticResource Celula.Mono}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
