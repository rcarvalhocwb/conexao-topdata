<UserControl x:Class="Desktop.App.Telas.Consulta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Consultar código">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Pagina.Titulo}" Text="Consultar código" />
      <TextBlock Style="{StaticResource Pagina.Descricao}"
                 Text="Digite o número do cartão ou do ingresso, ou passe no leitor do balcão. O número não fica guardado na tela: aparece só mascarado." />
    </StackPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Rayzer.Card}" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="CampoDoCodigo" Width="360" Margin="0,0,8,0" FontFamily="{DynamicResource Rayzer.Font.Mono}"
                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código a consultar">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding Consultar}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Style="{StaticResource Rayzer.Button.Primary}" Content="_Consultar" Command="{Binding Consultar}" />
      </StackPanel>
    </Border>

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <!-- Credencial: cada dado com rótulo à esquerda, leitura rápida. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Rayzer.Card}" Margin="0,0,0,12"
            Visibility="{Binding Detalhes, Converter={StaticResource ZeroParaVisivel}, ConverterParameter=inverso}">
      <ItemsControl ItemsSource="{Binding Detalhes}" AutomationProperties.Name="Situação do código">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4,16,8">
              <TextBlock Style="{StaticResource Rayzer.Text.Label}" Margin="0,0,0,2" Text="{Binding Rotulo}" />
              <TextBlock Style="{StaticResource Rayzer.Text.Body}" FontWeight="SemiBold" Text="{Binding Valor}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rayzer.Text.Section}" Text="Últimas tentativas com este código" />
    <Grid>
      <DataGrid ItemsSource="{Binding Historico}" AutomationProperties.Name="Histórico do código">
        <DataGrid.Columns>
          <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="84" ElementStyle="{StaticResource Celula.Mono}" />
          <DataGridTextColumn Header="CATRACA" Binding="{Binding Inner}" Width="76" />
          <DataGridTemplateColumn Header="RESULTADO" Width="*" CellTemplate="{StaticResource Celula.Acesso}" />
          <DataGridTextColumn Header="GIROU" Binding="{Binding Girou, Converter={StaticResource SimOuTraco}}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>
      <rz:RayzerEmptyState Icone="{DynamicResource Rayzer.Icon.Card}" Titulo="Nenhuma consulta ainda"
                           Texto="O histórico do código consultado aparece aqui."
                           Visibility="{Binding Historico, Converter={StaticResource ZeroParaVisivel}}" />
    </Grid>
  </DockPanel>
</UserControl>
