<UserControl x:Class="Desktop.App.Telas.CartoesNaoReconhecidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Cartões não reconhecidos">
  <DockPanel>
    <rz:RayzerPageHeader DockPanel.Dock="Top" Titulo="Cartões não reconhecidos"
                         Descricao="Leituras que a catraca recusou porque o cartão não está cadastrado. Abra uma sessão de lote para cadastrar os cartões lidos na urna: eles entram no lote e ninguém passa. O código aparece mascarado." />

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Sessão de lote e formulário ===== -->
      <Border Grid.Column="0" Style="{StaticResource Rayzer.Card}" Padding="16,14">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="Sessão de lote" />
          <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding SessaoResumo}" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Código do provedor de cartões" />
          <TextBox Margin="0,2,0,8" Text="{Binding Provedor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código do provedor de cartões" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Tipo de entrada (INTEIRA, MEIA…)" />
          <TextBox Margin="0,2,0,8" Text="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tipo de entrada" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome do lote" />
          <TextBox Margin="0,2,0,8" Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do lote" />

          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Usos por cartão (de 1 a 50)" />
          <TextBox Width="90" HorizontalAlignment="Left" Margin="0,2,0,12" Text="{Binding Usos, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usos por cartão" />

          <WrapPanel>
            <Button Margin="0,0,8,8" Style="{StaticResource Rayzer.Button.Primary}" Content="_Abrir sessão" Command="{Binding AbrirSessao}" />
            <Button Margin="0,0,0,8" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Fechar sessão" Command="{Binding FecharSessao}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ===== Leituras recusadas ===== -->
      <Border Grid.Column="2" Style="{StaticResource Rayzer.Card}" Padding="16,14">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Atualizar" Command="{Binding Atualizar}" />
            <rz:RayzerSectionHeader Titulo="Leituras recusadas" />
          </DockPanel>

          <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Rayzer.Button.Primary}"
                  Content="_Cadastrar a leitura selecionada" Command="{Binding Cadastrar}" />

          <DataGrid ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada}" AutomationProperties.Name="Leituras recusadas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CÓDIGO (MASCARADO)" Binding="{Binding Codigo}" Width="*" ElementStyle="{StaticResource Celula.Mono}" />
              <DataGridTextColumn Header="VEZES" Binding="{Binding Vezes}" Width="70" />
              <DataGridTextColumn Header="ÚLTIMA" Binding="{Binding Ultima}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
