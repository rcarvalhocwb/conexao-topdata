<UserControl x:Class="Desktop.App.Telas.Visitas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Visitas">
  <DockPanel>
    <rz:RayzerPageHeader DockPanel.Dock="Top" Titulo="Visitas"
                        Descricao="Agende para um anfitrião ativo. Na chegada, confira o documento e entregue a credencial provisória. Registre a saída para encerrar o acesso. Horários de Brasília; cadastro somente neste computador." />
    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Rayzer.Card}" Padding="16,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Nova visita" Command="{Binding NovaVisita}" />
              <rz:RayzerSectionHeader Titulo="Agenda" />
            </DockPanel>
            <DockPanel Margin="0,8,0,10">
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="_Atualizar" Command="{Binding Atualizar}" Style="{StaticResource Rayzer.Button.Primary}" />
              <ComboBox ItemsSource="{Binding Situacoes}" DisplayMemberPath="Nome" SelectedValuePath="Codigo"
                        SelectedValue="{Binding Filtro}" AutomationProperties.Name="Filtrar visitas por situação" />
            </DockPanel>
            <TextBlock Text="Selecione uma visita para registrar a chegada ou a saída. Mostra até 200 visitas mais recentes."
                       Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Margin="0,0,0,10" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Visitas}" SelectedItem="{Binding Selecionada}" RowHeight="54" AutomationProperties.Name="Agenda de visitas">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="VISITANTE" Width="*" MinWidth="165">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                      <TextBlock Text="{Binding Anfitriao, StringFormat=Anfitrião: {0}}" Style="{StaticResource Rayzer.Type.Caption}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Anfitriao}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding Situacao}" Width="105" />
              <DataGridTextColumn Header="JANELA" Binding="{Binding Janela}" Width="175">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Celula.Mono}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <TabControl Grid.Column="2" SelectedIndex="{Binding Aba}">
        <!-- O estilo global põe 230 px de passos à esquerda; aqui as duas abas ficam acima do formulário. -->
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,8" KeyboardNavigation.TabIndex="1" />
              <Border Grid.Row="1" Style="{StaticResource Rayzer.Card}" Padding="8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="Agendar">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14" IsEnabled="{Binding PodeAgendar}">
              <rz:RayzerSectionHeader Titulo="Pré-cadastro" />
              <TextBlock Text="Agendar não cria uma credencial nem libera a catraca." TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" Margin="0,0,0,12" />
              <TextBlock Text="Nome completo do visitante" Style="{StaticResource Rayzer.Type.Label}" />
              <TextBox MaxLength="150" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Nome completo do visitante" />
              <TextBlock Text="Buscar anfitrião pelo nome" Style="{StaticResource Rayzer.Type.Label}" />
              <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarAnfitrioes}" Style="{StaticResource Rayzer.Button.Ghost}" Margin="8,0,0,0" />
                <TextBox Text="{Binding BuscaAnfitriao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do anfitrião para busca" />
              </DockPanel>
              <ComboBox ItemsSource="{Binding Anfitrioes}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding AnfitriaoId}"
                        Margin="0,0,0,10" AutomationProperties.Name="Anfitrião da visita" />
              <TextBlock Text="Motivo da visita" Style="{StaticResource Rayzer.Type.Label}" />
              <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,4,0,10" AutomationProperties.Name="Motivo da visita" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Início — data" Style="{StaticResource Rayzer.Type.Label}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Hora (hh:mm)" Style="{StaticResource Rayzer.Type.Label}" />
                <DatePicker Grid.Row="1" SelectedDate="{Binding DataDe}" Margin="0,4,0,10" AutomationProperties.Name="Data inicial da visita" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HoraDe, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0,4,0,10" AutomationProperties.Name="Hora inicial da visita" />
                <TextBlock Grid.Row="2" Text="Fim — data" Style="{StaticResource Rayzer.Type.Label}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Hora (hh:mm)" Style="{StaticResource Rayzer.Type.Label}" />
                <DatePicker Grid.Row="3" SelectedDate="{Binding DataAte}" Margin="0,4,0,0" AutomationProperties.Name="Data final da visita" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding HoraAte, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0,4,0,0" AutomationProperties.Name="Hora final da visita" />
              </Grid>
              <Button Content="Agendar _visita" Command="{Binding Agendar}" Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Chegada e saída">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14">
              <TextBlock Text="Selecione uma visita na agenda." Style="{StaticResource Rayzer.Type.Body}" Margin="0,0,0,8" />
              <StackPanel Visibility="{Binding TemSelecao, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Selecionada.Nome}" Style="{StaticResource Rayzer.Type.Section}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Selecionada.Anfitriao, StringFormat=Anfitrião: {0}}" TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" />
                <TextBlock Text="{Binding Selecionada.Janela}" TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Selecionada.Motivo}" TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,8" />
                <TextBlock Text="{Binding Selecionada.Situacao}" Style="{StaticResource Rayzer.Type.Label}" Margin="0,0,0,10" />
                <StackPanel IsEnabled="{Binding PodeReceber}" Visibility="{Binding Selecionada.PodeReceber, Converter={StaticResource BoolParaVisibilidade}}">
                  <rz:RayzerSectionHeader Titulo="Registrar chegada" />
                  <TextBlock Text="Confira o documento apresentado. O perfil Visitante define quais dados são obrigatórios."
                             TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" Margin="0,0,0,8" />
                  <DockPanel Margin="0,0,0,8">
                    <ComboBox DockPanel.Dock="Left" Width="120" ItemsSource="{Binding TiposDeDocumento}" DisplayMemberPath="Nome" SelectedValuePath="Codigo"
                              SelectedValue="{Binding TipoDoDocumento}" Margin="0,0,8,0" AutomationProperties.Name="Tipo do documento do visitante" />
                    <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Documento apresentado pelo visitante" />
                  </DockPanel>
                  <CheckBox Content="Conferi o documento apresentado" IsChecked="{Binding DocumentoConferido}" Margin="0,0,0,12" />
                  <TextBlock Text="Credencial provisória" Style="{StaticResource Rayzer.Type.Label}" />
                  <DockPanel Margin="0,4,0,10">
                    <ComboBox DockPanel.Dock="Left" Width="130" ItemsSource="{Binding TiposDeCredencial}" DisplayMemberPath="Nome" SelectedValuePath="Codigo"
                              SelectedValue="{Binding TipoDaCredencial}" Margin="0,0,8,0" AutomationProperties.Name="Tipo da credencial provisória" />
                    <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="Código da credencial provisória" />
                  </DockPanel>
                  <Button Content="Registrar _chegada" Command="{Binding Receber}" Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                </StackPanel>
                <TextBlock Text="{Binding Selecionada.Documento, StringFormat=Documento: {0}}" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Selecionada.Codigo, StringFormat=Credencial: {0}}" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Selecionada.Chegada, StringFormat=Chegada: {0}}" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Selecionada.Saida, StringFormat=Saída: {0}}" Style="{StaticResource Rayzer.Type.Body}" Margin="0,4,0,10" />
                <StackPanel IsEnabled="{Binding PodeEncerrar}" Visibility="{Binding Selecionada.PodeEncerrar, Converter={StaticResource BoolParaVisibilidade}}">
                  <CheckBox Content="Confirmo a saída e o recolhimento da credencial" IsChecked="{Binding SaidaConfirmada}" Margin="0,0,0,10" />
                  <Button Content="Registrar _saída" Command="{Binding Encerrar}" Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" />
                  <TextBlock Text="Encerra o acesso na próxima leitura, mesmo antes do fim da janela." TextWrapping="Wrap" Style="{StaticResource Rayzer.Type.Body}" Margin="0,8,0,0" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
