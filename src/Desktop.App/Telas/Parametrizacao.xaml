<UserControl x:Class="Desktop.App.Telas.Parametrizacao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Parametrização da catraca">
  <!--
    Parametrização da catraca (Etapa A.6 do docs/35; layout do docs/34-anexos/04 §4.2).
    O detalhe de uma catraca, aberto pela "Gerenciar catraca". À esquerda, as abas com os campos
    (validação no campo); à direita, "o que muda (atual → novo)" antes de salvar e o aplicar com
    confirmação, com o resultado vindo do histórico de comandos.
    Modo guiado: só os campos do operador, com as palavras dele. Modo técnico: todos, com os
    nomes do SDK, e a aba Instalação. O que aguarda confirmação aparece desabilitado, com o
    selo e o motivo. 1366 × 768: a página rola na vertical; nada é cortado na horizontal.
  -->
  <UserControl.Resources>
    <!-- Um campo: o mesmo desenho do painel de cada peça no gêmeo (Telas/CampoDaCatraca.xaml). -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Desktop.App;component/Telas/CampoDaCatraca.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <rz:RayzerPageHeader Titulo="Parametrização da catraca"
                           Descricao="O que esta catraca usa de diferente do evento. Salvar grava; a catraca só passa a usar depois de &quot;Aplicar nesta catraca&quot;, que pede confirmação.">
        <StackPanel Orientation="Horizontal">
          <!-- O gêmeo é a porta principal da configuração (docs/33 §9); esta é a mesma, em lista. -->
          <Button Style="{StaticResource Rayzer.Button.Ghost}" Margin="0,0,8,0" Content="Abrir no gê_meo"
                  Command="{Binding DataContext.AbrirNoGemeo, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding Catraca}" AutomationProperties.Name="Abrir esta catraca no gêmeo digital"
                  ToolTip="A mesma configuração, peça por peça, no desenho 3D da catraca." />
          <Button Style="{StaticResource Rayzer.Button.Ghost}" Content="Voltar a _Gerenciar catraca"
                  Command="{Binding DataContext.Gerenciar, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding Catraca}" AutomationProperties.Name="Voltar a Gerenciar catraca" />
        </StackPanel>
      </rz:RayzerPageHeader>

      <!-- Qual catraca, quem está mudando, o modo, e se o salvo já está na catraca. -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="16,12,16,0" Margin="0,0,0,12">
        <WrapPanel>
          <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Catraca" />
            <ComboBox Width="200" ItemsSource="{Binding Catracas}" DisplayMemberPath="Nome" SelectedValuePath="Inner"
                      SelectedValue="{Binding Catraca}" AutomationProperties.Name="Catraca" />
          </StackPanel>
          <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Seu nome (fica registrado)" />
            <TextBox Width="200" Text="{Binding Operador, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Operador" />
          </StackPanel>
          <StackPanel Margin="{StaticResource Rayzer.Margin.Field}" VerticalAlignment="Bottom">
            <CheckBox IsChecked="{Binding ModoTecnico}" Content="Modo técnico"
                      ToolTip="Mostra todos os parâmetros, com os nomes técnicos. É uma conveniência, não uma proteção: o que não está confirmado continua bloqueado." />
          </StackPanel>
          <StackPanel Margin="{StaticResource Rayzer.Margin.Field}" MaxWidth="400">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Na catraca" />
            <rz:RayzerStatusPill HorizontalAlignment="Left" Tom="{Binding SinalDaSituacao, Converter={StaticResource SinalParaTom}}"
                                 Texto="{Binding SituacaoNaCatraca}" AutomationProperties.Name="Situação da configuração na catraca" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding DetalheDaSituacao}" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <rz:RayzerAlert Style="{StaticResource Pagina.Mensagem}" Tom="Marca" Titulo="{Binding Mensagem}"
                      Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />
      <ItemsControl ItemsSource="{Binding AvisosDoSalvo}" AutomationProperties.Name="Avisos do que está salvo">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <rz:RayzerAlert Margin="0,0,0,8" Tom="Atencao" Titulo="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- As abas: Leitura, Liberação, Display, só no modo técnico Instalação, e Giro (mapa de giro). -->
        <TabControl SelectedIndex="{Binding AbaSelecionada}" AutomationProperties.Name="Grupos da parametrização">
          <TabItem Header="_Leitura">
            <ItemsControl ItemsSource="{Binding CamposDaLeitura}" ItemTemplate="{StaticResource Campo.Parametrizacao}" Focusable="False" />
          </TabItem>
          <TabItem Header="Li_beração">
            <ItemsControl ItemsSource="{Binding CamposDaLiberacao}" ItemTemplate="{StaticResource Campo.Parametrizacao}" Focusable="False" />
          </TabItem>
          <TabItem Header="_Display">
            <ItemsControl ItemsSource="{Binding CamposDoDisplay}" ItemTemplate="{StaticResource Campo.Parametrizacao}" Focusable="False" />
          </TabItem>
          <TabItem Header="_Instalação" Visibility="{Binding ModoTecnico, Converter={StaticResource BoolParaVisibilidade}}">
            <ItemsControl ItemsSource="{Binding CamposDaInstalacao}" ItemTemplate="{StaticResource Campo.Parametrizacao}" Focusable="False" />
          </TabItem>
          <!-- Mapa de giro (D9): o mesmo painel do gêmeo, com salvar e aplicar próprios. -->
          <TabItem Header="_Giro">
            <ContentControl Margin="8,10,8,8" Content="{Binding Giro}" Focusable="False" />
          </TabItem>
        </TabControl>

        <StackPanel Grid.Column="2">
          <!-- Antes de salvar: exatamente o que muda, do atual para o novo. -->
          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
            <StackPanel>
              <rz:RayzerSectionHeader Titulo="O que muda (atual → novo)" />
              <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding ResumoDasMudancas}" />
              <ItemsControl ItemsSource="{Binding Mudancas}" AutomationProperties.Name="O que muda">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,10,0,0">
                      <TextBlock Style="{StaticResource Rayzer.Type.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Campo}" />
                      <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap">
                        <Run Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{Binding Atual, Mode=OneWay}" /><Run Text=" → " /><Run FontWeight="SemiBold" Text="{Binding Novo, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Problemas}" AutomationProperties.Name="Problemas">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <rz:RayzerAlert Margin="0,8,0,0" Tom="Perigo" Titulo="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource Rayzer.Button.Primary}" Margin="0,0,8,0" Content="_Salvar" Command="{Binding Salvar}" />
                <Button Style="{StaticResource Rayzer.Button.Ghost}" Content="_Desfazer" Command="{Binding Descartar}"
                        ToolTip="Volta ao que está salvo para esta catraca." />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Aplicar: com confirmação; o resultado vem do histórico, nunca presumido. -->
          <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
              <rz:RayzerSectionHeader Titulo="Aplicar na catraca" />
              <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding MotivoParaNaoAplicar}"
                         Visibility="{Binding MotivoParaNaoAplicar, Converter={StaticResource VazioSome}}" />
              <Button Style="{StaticResource Rayzer.Button.Ghost}" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Content="Aplicar _nesta catraca…" Command="{Binding PedirAplicacao}" />
              <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="{DynamicResource Rayzer.Radius.Md}" BorderThickness="1"
                      BorderBrush="{DynamicResource Rayzer.Warning}" Background="{DynamicResource Rayzer.Surface}"
                      Visibility="{Binding ConfirmandoAplicacao, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Text="{Binding TextoDaConfirmacao}" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Rayzer.Button.Primary}" Margin="0,0,8,0" Content="_Aplicar agora" Command="{Binding ConfirmarAplicacao}" />
                    <Button Style="{StaticResource Rayzer.Button.Ghost}" Content="_Cancelar" Command="{Binding CancelarAplicacao}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <TextBlock Margin="0,14,0,4" Style="{StaticResource Rayzer.Type.Label}" Text="Resultado (pedidos de aplicar desta catraca)" />
              <ItemsControl ItemsSource="{Binding Aplicacoes}" AutomationProperties.Name="Resultado dos pedidos de aplicar">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,6,0,0">
                      <rz:RayzerStatus Tom="{Binding Sinal, Converter={StaticResource SinalParaTom}}" Texto="{Binding Situacao}" />
                      <TextBlock Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap">
                        <Run Text="{Binding Hora, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Operador, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Resultado, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="Nenhum pedido de aplicar para esta catraca."
                         Visibility="{Binding Aplicacoes, Converter={StaticResource ZeroParaVisivel}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
