<UserControl x:Class="Desktop.App.Telas.Contas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Prestação de contas">
  <DockPanel>
    <rz:RayzerPageHeader DockPanel.Dock="Top" Titulo="Prestação de contas"
                         Descricao="O resumo do que aconteceu nas catracas no período, no horário de Brasília, e o CSV dele. Autorizado = a catraca liberou; com giro = a pessoa passou. &quot;De&quot; vazio = desde o começo. Os relatórios R1–R8 ainda não existem: veja &quot;Ainda não disponível&quot; no fim da página." />

    <Border DockPanel.Dock="Top" Style="{StaticResource Rayzer.Card}" Margin="0,0,0,12" Padding="16,12,4,0">
      <WrapPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="De (data · hora)" />
          <StackPanel Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding Desde}" AutomationProperties.Name="De" />
            <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraDesde, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="hh:mm — vazio = começo do dia" AutomationProperties.Name="Hora inicial" />
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="{StaticResource Rayzer.Margin.Field}">
          <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Até (data · hora; vazio = agora)" />
          <StackPanel Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding Ate}" AutomationProperties.Name="Até" />
            <TextBox Width="72" Margin="6,0,0,0" MaxLength="5" Text="{Binding HoraAte, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="hh:mm — vazio = fim do dia" AutomationProperties.Name="Hora final" />
          </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource Rayzer.Button.Primary}" VerticalAlignment="Bottom" Margin="{StaticResource Rayzer.Margin.Field}"
                Content="_Gerar" IsDefault="True" Command="{Binding Gerar}" />
        <Button VerticalAlignment="Bottom" Margin="{StaticResource Rayzer.Margin.Field}" Click="Exportar"
                IsEnabled="{Binding PodeExportar}" ToolTip="Gere a prestação de contas antes de exportar."
                AutomationProperties.Name="Exportar para Excel">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Rayzer.Icon}" FontSize="14" Text="{DynamicResource Rayzer.Icon.Download}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Exportar para Excel" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <!-- O período que os números cobrem, como o serviço aplicou (o mesmo que vai no CSV). -->
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Rayzer.Type.Secondary}"
               Visibility="{Binding Periodo, Converter={StaticResource VazioSome}}">
      <Run Text="Período: " /><Run FontWeight="SemiBold" Text="{Binding Periodo, Mode=OneWay}" />
    </TextBlock>

    <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-12,12" DataContext="{Binding Contas}">
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Autorizados" Valor="{Binding Liberados}" Tom="Sucesso"
                           Icone="{DynamicResource Rayzer.Icon.Check}" Detalhe="✓ a catraca liberou" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Com giro confirmado" Valor="{Binding Giros}" Tom="Marca"
                           Icone="{DynamicResource Rayzer.Icon.People}" Detalhe="a pessoa passou" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Negados" Valor="{Binding Negados}" Tom="Perigo"
                           Icone="{DynamicResource Rayzer.Icon.Denied}" Detalhe="× veja os motivos abaixo" />
    </UniformGrid>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
      <Grid DataContext="{Binding Contas}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="Por categoria" />
          <DataGrid ItemsSource="{Binding PorCategoria}" AutomationProperties.Name="Por categoria" Margin="0,0,0,16">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="*" />
              <DataGridTextColumn Header="AUTORIZADOS" Binding="{Binding Liberados}" Width="128" />
              <DataGridTextColumn Header="COM GIRO" Binding="{Binding Giros}" Width="104" />
            </DataGrid.Columns>
          </DataGrid>
          <rz:RayzerSectionHeader Titulo="Por catraca" />
          <DataGrid ItemsSource="{Binding PorCatraca}" AutomationProperties.Name="Por catraca" Margin="0,0,0,16">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CATRACA" Binding="{Binding Inner}" Width="*" />
              <DataGridTextColumn Header="AUTORIZADOS" Binding="{Binding Liberados}" Width="128" />
              <DataGridTextColumn Header="COM GIRO" Binding="{Binding Giros}" Width="104" />
              <DataGridTextColumn Header="NEGADOS" Binding="{Binding Negados}" Width="96" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <rz:RayzerSectionHeader Titulo="Por hora" />
          <DataGrid ItemsSource="{Binding PorHora}" AutomationProperties.Name="Por hora" Margin="0,0,0,16">
            <DataGrid.Columns>
              <DataGridTextColumn Header="HORA" Width="*" ElementStyle="{StaticResource Celula.Mono}"
                                  Binding="{Binding Hora, Converter={StaticResource InstanteParaTexto}, ConverterParameter='dd/MM HH:00'}" />
              <DataGridTextColumn Header="AUTORIZADOS" Binding="{Binding Liberados}" Width="128" />
              <DataGridTextColumn Header="NEGADOS" Binding="{Binding Negados}" Width="96" />
            </DataGrid.Columns>
          </DataGrid>
          <rz:RayzerSectionHeader Titulo="Motivos de negativa" />
          <DataGrid ItemsSource="{Binding Negativas}" AutomationProperties.Name="Motivos de negativa" Margin="0,0,0,16">
            <DataGrid.Columns>
              <DataGridTextColumn Header="MOTIVO" Binding="{Binding Mensagem}" Width="*" />
              <DataGridTextColumn Header="QUANTIDADE" Binding="{Binding Quantidade}" Width="124" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Grid>

      <!-- O que não existe aparece desabilitado, com o motivo: nada de fingir (docs/25, fase 6). -->
      <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,4,0,0">
        <StackPanel>
          <rz:RayzerSectionHeader Titulo="Ainda não disponível" />
          <ItemsControl ItemsSource="{Binding AindaNaoDisponivel}" AutomationProperties.Name="Relatórios ainda não disponíveis">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4,0,4">
                  <Button DockPanel.Dock="Left" Style="{StaticResource Rayzer.Button.Ghost}" MinWidth="260" IsEnabled="False"
                          Content="{Binding Rotulo}" />
                  <rz:RayzerStatusPill DockPanel.Dock="Left" Margin="12,0,12,0" VerticalAlignment="Center" Tom="Atencao"
                                       Texto="Aguardando confirmação" />
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding Valor}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
