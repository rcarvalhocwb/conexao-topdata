<UserControl x:Class="Desktop.App.Telas.CentralDaCatraca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             xmlns:vm="clr-namespace:Desktop.ViewModels;assembly=Desktop.ViewModels"
             AutomationProperties.Name="Configuração da peça">
  <!--
    O painel da peça clicada, na coluna de 360 px ao lado do desenho do gêmeo (docs/33 §9), que
    rola sozinha em 1366 × 768: o que a peça faz (a ficha de sempre) e os parâmetros dela, com
    origem e situação; o que aguarda confirmação aparece desabilitado, com o selo e o motivo.
    Peça sem parâmetro diz "nada a configurar nesta peça". O "o que muda", o Salvar e o Aplicar
    da catraca inteira ficam embaixo do desenho (Gemeo.xaml), visíveis de qualquer peça.
    Os campos, as regras e os pedidos são os da Parametrização e da Gerenciar catraca.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Desktop.App;component/Telas/CampoDaCatraca.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <!-- A peça clicada. -->
    <Border Style="{StaticResource Rayzer.Card}" Margin="0,0,0,12">
      <StackPanel>
        <!-- Nenhuma peça aberta: como chegar lá. -->
        <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap"
                   Text="Clique numa peça do desenho (ou escolha na lista de peças) para ver o que ela faz e mudar a configuração dela."
                   Visibility="{Binding SemPainel, Converter={StaticResource BoolParaVisibilidade}}" />

        <StackPanel Visibility="{Binding PainelAberto, Converter={StaticResource BoolParaVisibilidade}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" MinWidth="0" Padding="10,0" Content="Fechar"
                    Command="{Binding FecharPainel}" AutomationProperties.Name="Fechar o painel da peça" />
            <rz:RayzerSectionHeader Titulo="{Binding TituloDoPainel}" />
          </DockPanel>

          <!-- O que a peça faz: a ficha de sempre do gêmeo. -->
          <TextBlock Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap" Text="{Binding Ficha.OQueFaz}" />
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Ficha.Funcoes}" AutomationProperties.Name="Funções da peça">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,6">
                  <DockPanel>
                    <rz:RayzerStatusPill DockPanel.Dock="Right" Tom="{Binding Sinal, Converter={StaticResource SinalParaTom}}" Texto="{Binding Selo}" />
                    <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Text="{Binding Nome}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap" Text="{Binding Explicacao}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <rz:RayzerAlert Margin="0,8,0,0" Tom="Info" Titulo="Nada a configurar nesta peça."
                          Visibility="{Binding NadaAConfigurar, Converter={StaticResource BoolParaVisibilidade}}" />

          <!-- Os parâmetros da peça: os mesmos campos da Parametrização. -->
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding CamposDaPeca}" ItemTemplate="{StaticResource Campo.Parametrizacao}"
                        Focusable="False" AutomationProperties.Name="Parâmetros desta peça" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap" Text="{Binding AvisoDoModo}"
                     Visibility="{Binding AvisoDoModo, Converter={StaticResource VazioSome}}" />

          <!-- Relé 2: existe na placa, mas não muda por catraca até o ensaio. Só no modo técnico. -->
          <Border Padding="8,10,8,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Rayzer.Border.Subtle}"
                  Visibility="{Binding MostraRele2, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Rayzer.Type.Label}" TextWrapping="Wrap" Text="{x:Static vm:CentralDaCatracaViewModel.RotuloDoRele2}" />
              <TextBox IsEnabled="False" IsReadOnly="True" Text="{x:Static vm:CentralDaCatracaViewModel.ValorDoRele2}" TextWrapping="Wrap"
                       AutomationProperties.Name="Relé 2 (desabilitado)" />
              <rz:RayzerStatusPill Margin="0,8,0,0" HorizontalAlignment="Left" Tom="Atencao" Texto="Aguardando confirmação" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource Rayzer.Type.Secondary}" TextWrapping="Wrap"
                         Text="{x:Static vm:CentralDaCatracaViewModel.SeloDoRele2}" />
            </StackPanel>
          </Border>

          <!-- O giro (braços: o mapa inteiro; urna: a linha do leitor 2). Salvar e aplicar são os de cima. -->
          <ContentControl Margin="0,10,0,0" Content="{Binding Giro}" Focusable="False"
                          Visibility="{Binding MostraGiro, Converter={StaticResource BoolParaVisibilidade}}" />

          <!-- A placa de controle: o que o serviço sabe do equipamento. -->
          <StackPanel Margin="0,10,0,0" Visibility="{Binding MostraEquipamento, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Equipamento" />
            <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap">
              <Run Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="Versão do firmware: " /><Run Text="{Binding Firmware, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap">
              <Run Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="Relógio: " /><Run Text="{Binding RelogioDaCatraca, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <!-- Pedidos imediatos (os da Gerenciar catraca): vão agora, sem Salvar nem Aplicar. -->
          <StackPanel Margin="0,12,0,0" Visibility="{Binding MostraMensagemTemporaria, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Mensagem temporária (pedido imediato)" />
            <TextBlock Style="{StaticResource Rayzer.Type.Caption}" TextWrapping="Wrap"
                       Text="Não é configuração: vai agora para a catraca, sem Salvar nem Aplicar, e fica registrada com o seu nome." />
            <WrapPanel Margin="0,4,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Texto (até 32 letras)" />
                <TextBox Width="220" MaxLength="32" Text="{Binding Comandos.MensagemTemporaria, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Mensagem temporária" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Segundos" />
                <TextBox Width="64" Text="{Binding Comandos.DuracaoDaMensagem, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Segundos da mensagem" />
              </StackPanel>
            </WrapPanel>
            <Button Style="{StaticResource Rayzer.Button.Ghost}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Content="Mostrar no display" Command="{Binding Comandos.EnviarMensagem}" />
          </StackPanel>
          <StackPanel Margin="0,12,0,0" Visibility="{Binding MostraAcertarRelogio, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Manutenção (pedido imediato)" />
            <WrapPanel Margin="0,4,0,0">
              <Button Style="{StaticResource Rayzer.Button.Ghost}" Margin="0,0,8,6" Content="Acertar o relógio agora" Command="{Binding Comandos.AcertarRelogio}" />
              <Button Style="{StaticResource Rayzer.Button.Ghost}" Margin="0,0,0,6" Content="Refazer a conexão…" Command="{Binding Comandos.RefazerConexao}"
                      Visibility="{Binding MostraRefazerConexao, Converter={StaticResource BoolParaVisibilidade}}"
                      ToolTip="A catraca reconecta e recebe a configuração completa de novo. Fica alguns segundos sem atender." />
            </WrapPanel>
            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="{DynamicResource Rayzer.Radius.Md}"
                    Background="{DynamicResource Rayzer.Warning.Subtle}"
                    Visibility="{Binding Comandos.ConfirmandoRefazerConexao, Converter={StaticResource BoolParaVisibilidade}}">
              <StackPanel>
                <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Text="{Binding Comandos.TextoDaConfirmacaoDeRefazerConexao}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource Rayzer.Button.Primary}" Content="Confirmar e refazer" Command="{Binding Comandos.ConfirmarRefazerConexao}" />
                  <Button Style="{StaticResource Rayzer.Button.Ghost}" Content="Cancelar" Margin="10,0,0,0" Command="{Binding Comandos.CancelarRefazerConexao}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <rz:RayzerAlert Margin="0,8,0,0" Tom="Neutro" Titulo="{Binding Comandos.Mensagem}"
                          Visibility="{Binding Comandos.Mensagem, Converter={StaticResource VazioSome}}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
