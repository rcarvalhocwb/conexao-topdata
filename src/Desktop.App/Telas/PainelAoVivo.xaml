<UserControl x:Class="Desktop.App.Telas.PainelAoVivo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Painel ao vivo">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Os números do evento: a primeira coisa que o supervisor procura. -->
    <WrapPanel Grid.Row="0">
      <Border Style="{StaticResource Cartao}">
        <StackPanel>
          <TextBlock Style="{StaticResource Rotulo}" Text="Liberados" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Liberados}" AutomationProperties.Name="Liberados" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Cartao}">
        <StackPanel>
          <TextBlock Style="{StaticResource Rotulo}" Text="Giros confirmados" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Giros}" AutomationProperties.Name="Giros confirmados" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Cartao}">
        <StackPanel>
          <TextBlock Style="{StaticResource Rotulo}" Text="Negados" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Negados}" AutomationProperties.Name="Negados" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Cartao}">
        <StackPanel>
          <TextBlock Style="{StaticResource Rotulo}" Text="Entradas nos últimos 5 min" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding LiberadosUltimos5Minutos}" AutomationProperties.Name="Entradas nos últimos 5 minutos" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Cartao}">
        <StackPanel>
          <TextBlock Style="{StaticResource Rotulo}" Text="Aguardando envio à nuvem" />
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding PendentesDeEnvio}" AutomationProperties.Name="Aguardando envio à nuvem" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource Aviso}" FontWeight="SemiBold" Text="{Binding Resumo}" />
      <TextBlock Style="{StaticResource Rotulo}" Text="{Binding Internet}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Text="Catracas" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Catracas}" AutomationProperties.Name="Catracas">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- Cor, forma e texto: a cor nunca é o único portador da informação. -->
                <Border BorderThickness="6,1,1,1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                        BorderBrush="{Binding Sinal, Converter={StaticResource SinalParaPincel}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                             Fill="{Binding Sinal, Converter={StaticResource SinalParaPincel}}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Nome}" />
                      <TextBlock Text="{Binding Situacao}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                      <TextBlock HorizontalAlignment="Right" Text="{Binding UltimaDecisao}" />
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource Rotulo}" Text="{Binding UltimoEvento}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Text="Últimos acessos" />
        <DataGrid ItemsSource="{Binding UltimosAcessos}" AutomationProperties.Name="Últimos acessos">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="80" />
            <DataGridTextColumn Header="Catraca" Binding="{Binding Inner}" Width="70" />
            <DataGridTemplateColumn Header="Resultado" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                             Fill="{Binding Sinal, Converter={StaticResource SinalParaPincel}}" />
                    <TextBlock Text="{Binding Mensagem}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
