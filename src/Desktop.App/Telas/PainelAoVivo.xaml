<UserControl x:Class="Desktop.App.Telas.PainelAoVivo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Painel ao vivo">
  <!--
    Centro de comando. Ordem de leitura: a situação da operação (barra superior), os
    números, as catracas (quem caiu primeiro) e os acessos chegando.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Pagina.Titulo}" Text="Painel ao vivo" />
      <TextBlock Style="{StaticResource Pagina.Descricao}" Text="{Binding Resumo}" />
    </StackPanel>

    <!-- Os números da operação, desde o início desta base local. -->
    <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,-12,12">
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Acessos autorizados" Valor="{Binding Liberados}" Tom="Sucesso"
                           Icone="{DynamicResource Rayzer.Icon.Check}" Detalhe="✓ total desta base"
                           AutomationProperties.Name="Acessos autorizados" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Passagens confirmadas" Valor="{Binding Giros}" Tom="Marca"
                           Icone="{DynamicResource Rayzer.Icon.People}" Detalhe="giro da catraca confirmado"
                           AutomationProperties.Name="Passagens confirmadas" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Acessos negados" Valor="{Binding Negados}" Tom="Perigo"
                           Icone="{DynamicResource Rayzer.Icon.Denied}" Detalhe="× total desta base"
                           AutomationProperties.Name="Acessos negados" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Fluxo · últimos 5 min" Valor="{Binding LiberadosUltimos5Minutos}" Tom="Info"
                           Icone="{DynamicResource Rayzer.Icon.History}" Detalhe="entradas autorizadas"
                           AutomationProperties.Name="Entradas nos últimos 5 minutos" />
      <rz:RayzerMetricCard Margin="0,0,12,0" Rotulo="Aguardando envio à nuvem" Valor="{Binding PendentesDeEnvio}"
                           Tom="{Binding PendentesDeEnvio, Converter={StaticResource PendenciaParaTom}}"
                           Icone="{DynamicResource Rayzer.Icon.Cloud}" Detalhe="sobe sozinho quando há internet"
                           AutomationProperties.Name="Aguardando envio à nuvem" />
    </UniformGrid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="300" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rayzer.Type.Section}" Text="Catracas" />
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0">
            <ItemsControl ItemsSource="{Binding Catracas}" ItemTemplate="{StaticResource Cartao.Catraca}"
                          AutomationProperties.Name="Catracas" />
          </ScrollViewer>
          <rz:RayzerEmptyState Icone="{DynamicResource Rayzer.Icon.Devices}" Titulo="Nenhuma catraca configurada"
                               Texto="As catracas aparecem aqui depois do Assistente de configuração (passo 2)."
                               Visibility="{Binding Catracas, Converter={StaticResource ZeroParaVisivel}}" />
        </Grid>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rayzer.Type.Section}" Text="Acessos em tempo real" />
        <Grid>
          <DataGrid ItemsSource="{Binding UltimosAcessos}" AutomationProperties.Name="Últimos acessos">
            <DataGrid.Columns>
              <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="84" ElementStyle="{StaticResource Celula.Mono}" />
              <DataGridTextColumn Header="CATRACA" Binding="{Binding Inner}" Width="76" />
              <DataGridTemplateColumn Header="RESULTADO" Width="*" CellTemplate="{StaticResource Celula.Acesso}" />
              <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource Celula.Mono}" />
            </DataGrid.Columns>
          </DataGrid>
          <rz:RayzerEmptyState Icone="{DynamicResource Rayzer.Icon.List}" Titulo="Aguardando o primeiro acesso"
                               Texto="Cada leitura nas catracas aparece aqui na hora, autorizada ou negada."
                               Visibility="{Binding UltimosAcessos.Count, Converter={StaticResource ZeroParaVisivel}}" />
        </Grid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
