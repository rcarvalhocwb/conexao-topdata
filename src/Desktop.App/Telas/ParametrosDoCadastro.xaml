<UserControl x:Class="Desktop.App.Telas.ParametrosDoCadastro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rz="clr-namespace:Rayzer.Design;assembly=Rayzer.Design"
             AutomationProperties.Name="Empresas, horários e perfis">
  <DockPanel>
    <rz:RayzerPageHeader DockPanel.Dock="Top" Titulo="Empresas, horários e perfis"
                         Descricao="O que o cadastro de pessoas usa: empresas e salas, tabelas de horário (horário de Brasília) e feriados, e os perfis com os campos obrigatórios e as regras padrão de cada tipo de pessoa." />

    <rz:RayzerAlert DockPanel.Dock="Top" Style="{StaticResource Pagina.Mensagem}" Titulo="{Binding Mensagem}"
                    Visibility="{Binding Mensagem, Converter={StaticResource VazioSome}}" />

    <TabControl>
      <!-- ===== Perfis ===== -->
      <TabItem Header="Perfis">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Rayzer.Card}" Padding="16,14">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Novo perfil" Command="{Binding NovoPerfil}" />
                <rz:RayzerSectionHeader Titulo="Perfis" />
              </DockPanel>
              <DataGrid ItemsSource="{Binding Perfis}" SelectedItem="{Binding PerfilSelecionado}" AutomationProperties.Name="Perfis de pessoa">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="PERFIL" Binding="{Binding Nome}" Width="110" />
                  <DataGridTextColumn Header="ORIGEM" Binding="{Binding Origem}" Width="90" />
                  <DataGridTextColumn Header="REGRAS" Binding="{Binding Regras}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
              <StackPanel>
                <rz:RayzerSectionHeader Titulo="{Binding TituloDoPerfil}" />
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome do perfil" />
                <TextBox Margin="0,4,0,10" MaxLength="40" Text="{Binding PerfilNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do perfil" />
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Campos obrigatórios no cadastro" />
                <ItemsControl Margin="0,4,0,10" ItemsSource="{Binding CamposDoPerfil}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Width="180" Margin="0,2" IsChecked="{Binding Marcado}" Content="{Binding Nome}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Margin="0,0,0,10" IsChecked="{Binding PerfilExigeAnfitriao}" Content="Exige quem recebe (visitante)" />
                <WrapPanel>
                  <StackPanel Margin="0,0,12,10">
                    <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Validade (dias; 0 = no dia)" />
                    <TextBox Width="90" Margin="0,4,0,0" Text="{Binding PerfilDiasDeValidade, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dias de validade" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,10">
                    <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Entradas por dia" />
                    <TextBox Width="90" Margin="0,4,0,0" Text="{Binding PerfilLimite, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Entradas por dia do perfil" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,10">
                    <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Guardar após inativar (dias)" />
                    <TextBox Width="90" Margin="0,4,0,0" Text="{Binding PerfilRetencao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dias de retenção" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Tabela de horário" />
                <ComboBox Margin="0,4,0,10" ItemsSource="{Binding OpcoesDeHorario}" DisplayMemberPath="Nome" SelectedValuePath="Codigo"
                          SelectedValue="{Binding PerfilHorarioId}" AutomationProperties.Name="Tabela de horário do perfil" />
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Catracas permitidas (ex.: 1, 2; vazio = todas)" />
                <TextBox Margin="0,4,0,10" Text="{Binding PerfilCatracas, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Catracas do perfil" />
                <CheckBox Margin="0,0,0,12" IsChecked="{Binding PerfilAtivo}" Content="Ativo (aparece no cadastro)" />
                <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Content="_Gravar perfil" Command="{Binding GravarPerfil}" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ===== Horários e feriados ===== -->
      <TabItem Header="Horários e feriados">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="Nova _tabela" Command="{Binding NovoHorario}" />
                    <rz:RayzerSectionHeader Titulo="Tabelas de horário (até 100)" />
                  </DockPanel>
                  <DataGrid ItemsSource="{Binding Horarios}" SelectedItem="{Binding HorarioSelecionado}" MaxHeight="220" AutomationProperties.Name="Tabelas de horário">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="48" ElementStyle="{StaticResource Celula.Mono}" />
                      <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="120" />
                      <DataGridTextColumn Header="FAIXAS" Binding="{Binding Resumo}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
                <StackPanel>
                  <rz:RayzerSectionHeader Titulo="Feriados (usam a linha Feriado da tabela)" />
                  <DataGrid ItemsSource="{Binding Feriados}" SelectedItem="{Binding FeriadoSelecionado}" MaxHeight="180" AutomationProperties.Name="Feriados">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="DIA" Binding="{Binding Dia}" Width="100" ElementStyle="{StaticResource Celula.Mono}" />
                      <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <WrapPanel Margin="0,10,0,0">
                    <DatePicker Width="130" SelectedDate="{Binding FeriadoDia}" AutomationProperties.Name="Dia do feriado" />
                    <TextBox Width="180" Margin="8,0,0,0" Text="{Binding FeriadoNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do feriado" />
                    <Button Margin="8,0,0,0" Content="_Marcar feriado" Command="{Binding GravarFeriado}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Rayzer.Button.Ghost}" Content="_Desmarcar o selecionado" Command="{Binding ExcluirFeriado}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
              <StackPanel>
                <rz:RayzerSectionHeader Titulo="{Binding TituloDoHorario}" />
                <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome da tabela" />
                <TextBox Margin="0,4,0,10" MaxLength="60" Text="{Binding HorarioNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da tabela de horário" />
                <TextBlock Style="{StaticResource Rayzer.Type.Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Faixas de cada dia como 08:00-12:00, 13:00-18:00 (até 4 por dia; o fim não entra). Dia vazio não libera. Mais de 2 faixas por dia talvez não caibam na lista off-line do Inner (a confirmar na bancada)." />
                <ItemsControl ItemsSource="{Binding Dias}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Width="80" VerticalAlignment="Center" Style="{StaticResource Rayzer.Type.Label}" Text="{Binding Nome}" />
                        <TextBox Text="{Binding Faixas, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Nome}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource Rayzer.Button.Primary}" Content="_Gravar tabela" Command="{Binding GravarHorario}" />
                  <Button Style="{StaticResource Rayzer.Button.Ghost}" Margin="8,0,0,0" Content="E_xcluir tabela" Command="{Binding ExcluirHorario}"
                          ToolTip="Só exclui tabela que nenhum perfil nem pessoa usa." />
                </WrapPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ===== Empresas e salas ===== -->
      <TabItem Header="Empresas e salas">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="Nova _empresa" Command="{Binding NovaEmpresa}" />
                    <rz:RayzerSectionHeader Titulo="Empresas" />
                  </DockPanel>
                  <DataGrid ItemsSource="{Binding Empresas}" SelectedItem="{Binding EmpresaSelecionada}" MaxHeight="200" AutomationProperties.Name="Empresas">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="EMPRESA" Binding="{Binding Nome}" Width="*" />
                      <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="140" ElementStyle="{StaticResource Celula.Mono}" />
                      <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding Situacao}" Width="100" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
                <StackPanel>
                  <rz:RayzerSectionHeader Titulo="{Binding TituloDaEmpresa}" />
                  <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome" />
                  <TextBox Margin="0,4,0,10" MaxLength="120" Text="{Binding EmpresaNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da empresa" />
                  <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="CNPJ (opcional)" />
                  <TextBox Margin="0,4,0,10" Text="{Binding EmpresaCnpj, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CNPJ" />
                  <CheckBox Margin="0,0,0,12" IsChecked="{Binding EmpresaAtiva}" Content="Ativa" />
                  <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Content="Gravar empresa" Command="{Binding GravarEmpresa}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Rayzer.Button.Ghost}" Content="Nova _sala" Command="{Binding NovaSala}" />
                    <rz:RayzerSectionHeader Titulo="Salas e unidades" />
                  </DockPanel>
                  <DataGrid ItemsSource="{Binding Salas}" SelectedItem="{Binding SalaSelecionada}" MaxHeight="200" AutomationProperties.Name="Salas">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="SALA" Binding="{Binding Nome}" Width="*" />
                      <DataGridTextColumn Header="EMPRESA" Binding="{Binding Empresa}" Width="120" />
                      <DataGridTextColumn Header="LOCAL" Binding="{Binding Local}" Width="110" />
                      <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding Situacao}" Width="100" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Rayzer.Card}" Padding="16,14" Margin="0,12,0,0">
                <StackPanel>
                  <rz:RayzerSectionHeader Titulo="{Binding TituloDaSala}" />
                  <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Nome (sala, conjunto, apartamento, unidade)" />
                  <TextBox Margin="0,4,0,10" MaxLength="80" Text="{Binding SalaNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da sala" />
                  <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Empresa" />
                  <ComboBox Margin="0,4,0,10" ItemsSource="{Binding OpcoesDeEmpresa}" DisplayMemberPath="Nome" SelectedValuePath="Codigo"
                            SelectedValue="{Binding SalaEmpresaId}" AutomationProperties.Name="Empresa da sala" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Andar" />
                      <TextBox Width="90" Margin="0,4,0,0" Text="{Binding SalaAndar, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Andar" />
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock Style="{StaticResource Rayzer.Type.Label}" Text="Bloco" />
                      <TextBox Width="90" Margin="0,4,0,0" Text="{Binding SalaBloco, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bloco" />
                    </StackPanel>
                  </StackPanel>
                  <CheckBox Margin="0,0,0,12" IsChecked="{Binding SalaAtiva}" Content="Ativa" />
                  <Button Style="{StaticResource Rayzer.Button.Primary}" HorizontalAlignment="Left" Content="Gravar sala" Command="{Binding GravarSala}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
