<Application x:Class="Edge.Configurador.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Rayzer XAcess — Assistente de configuração. Mesma identidade do painel: tokens, tema e
    estilos do Rayzer Design System (src/Rayzer.Design, docs/27).
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Rayzer.Design;component/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Rayzer.Design;component/Temas/Claro.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Rayzer.Design;component/Controles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource Rayzer.Type.Title}">
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
      <Style x:Key="Descricao" TargetType="TextBlock" BasedOn="{StaticResource Rayzer.Type.Secondary}">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Rayzer.Type.Label}">
        <Setter Property="Margin" Value="0,16,0,6" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
