<Window x:Class="Edge.Configurador.JanelaDoAssistente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexão Topdata — Assistente de configuração"
        Height="700" Width="1000" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BotaoVoltar" Content="_Voltar" Click="Voltar" />
      <Button x:Name="BotaoAvancar" Content="_Avançar" Click="Avancar" />
    </StackPanel>

    <TabControl x:Name="Passos" TabStripPlacement="Left" SelectionChanged="PassoMudou">

      <!-- 1. O PC tem o que precisa? -->
      <TabItem Header="1. Ambiente">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
          <StackPanel>
            <TextBlock Style="{StaticResource Titulo}" Text="Este computador tem o que precisa?" />
            <TextBlock Text="Itens em vermelho impedem as catracas de funcionar. Instale o que faltar e clique em Verificar de novo." />
            <ItemsControl x:Name="ListaDoAmbiente" Margin="0,16,0,16" AutomationProperties.Name="Verificação do ambiente">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="6,1,1,1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" BorderBrush="{Binding Cor}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold"><Run Text="{Binding Marca, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Item, Mode=OneWay}" /></TextBlock>
                      <TextBlock Text="{Binding Orientacao}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel>
              <Button Content="Verificar de _novo" Click="VerificarAmbiente" Margin="0,0,8,8" />
              <Button Content="_Localizar EasyInner.dll…" Click="LocalizarEasyInner" Margin="0,0,8,8" />
              <Button x:Name="BotaoNet35" Content="Habilitar .NET _Framework 3.5" Click="HabilitarNet35" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock x:Name="TextoDoAmbiente" FontSize="14" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2. Quais catracas? -->
      <TabItem Header="2. Catracas">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Titulo}" Text="Quais catracas este computador atende?" />
            <TextBlock Text="O número é o do Inner configurado em cada catraca. O nome é o que aparece no painel. Em cada catraca, aponte o servidor para o IP deste computador e para a porta abaixo." />
            <TextBlock Style="{StaticResource Rotulo}" Text="Porta (padrão 3570)" />
            <TextBox x:Name="CampoPorta" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Porta" />
            <TextBlock Style="{StaticResource Rotulo}" Text="Catracas (clique na última linha para incluir; selecione e tecle Delete para tirar)" />
          </StackPanel>
          <DataGrid x:Name="GradeDeCatracas" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                    HeadersVisibility="Column" RowHeight="34" FontSize="14" AutomationProperties.Name="Catracas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Número do Inner" Binding="{Binding Inner}" Width="160" />
              <DataGridTextColumn Header="Nome no painel" Binding="{Binding Nome}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- 3. Nuvem -->
      <TabItem Header="3. Nuvem">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Titulo}" Text="Painel na nuvem" />
            <TextBlock Text="Opcional. Sem a nuvem, as catracas funcionam do mesmo jeito; só não recebem os cartões cadastrados lá nem enviam os acessos." />
            <CheckBox x:Name="CaixaNuvem" Margin="0,16,0,0" MinHeight="32" VerticalContentAlignment="Center"
                      Content="Sincronizar com o painel na nuvem" />
            <TextBlock Style="{StaticResource Rotulo}" Text="Endereço das funções (https://…/functions/v1/)" />
            <TextBox x:Name="CampoBase" AutomationProperties.Name="Endereço da nuvem" />
            <TextBlock Style="{StaticResource Rotulo}" Text="Identificador deste computador no painel" />
            <TextBox x:Name="CampoDispositivo" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Identificador do computador" />
            <TextBlock Style="{StaticResource Rotulo}" Text="Formato do número do cartão (confirmar na bancada — docs/21)" />
            <ComboBox x:Name="CampoPerfil" Width="240" HorizontalAlignment="Left" MinHeight="36" AutomationProperties.Name="Formato do cartão">
              <ComboBoxItem Content="raw" />
              <ComboBoxItem Content="mifare-catraca4" />
              <ComboBoxItem Content="qr-catraca4" />
            </ComboBox>
            <TextBlock Style="{StaticResource Rotulo}" Text="Intervalo mínimo para o mesmo cartão voltar (segundos; 240 = 4 minutos)" />
            <TextBox x:Name="CampoReuso" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Intervalo de reuso" />
            <CheckBox x:Name="CaixaUrna" Margin="0,16,0,0" MinHeight="32" VerticalContentAlignment="Center"
                      Content="Cartão da bilheteria só vale na fenda da urna" />
            <TextBlock Style="{StaticResource Rotulo}" Text="Segredo de acesso à nuvem (deixe em branco para manter o atual)" />
            <PasswordBox x:Name="CampoSegredo" AutomationProperties.Name="Segredo da nuvem" />
            <TextBlock Style="{StaticResource Rotulo}" Text="O segredo fica guardado no cofre do Windows deste computador. Ele nunca é gravado em arquivo." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 4. Gravar -->
      <TabItem Header="4. Gravar">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
          <StackPanel>
            <TextBlock Style="{StaticResource Titulo}" Text="Conferir e gravar" />
            <TextBlock x:Name="TextoResumo" FontSize="14" />
            <ItemsControl x:Name="ListaDeProblemas" Margin="0,12,0,12" AutomationProperties.Name="Problemas">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" Text="{Binding StringFormat='• {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BotaoGravar" Content="_Gravar e iniciar o serviço" Click="Gravar" />
            </StackPanel>
            <TextBlock x:Name="TextoResultado" FontSize="14" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
