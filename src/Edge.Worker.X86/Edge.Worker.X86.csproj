<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hospedeiro do worker. ÚNICO executável que carrega a EasyInner.dll.

    PlatformTarget x86 é obrigatório: a DLL é de 32 bits, e um processo de 64 bits
    falha com "Can't load IA 32-bit .dll on a AMD 64-bit platform" ou com o retorno 8.
    Ver manual, seções 1.3.3 e 6.6, e docs/ADR/ADR-0001.

    O projeto é fino de propósito: toda a lógica está em Edge.Worker, que roda e é
    testada em qualquer plataforma. Aqui só se decide QUAL adapter injetar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Edge.Worker.X86</AssemblyName>
    <RootNamespace>Edge.Worker.X86</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Edge.Worker/Edge.Worker.csproj" />
    <!-- Só o modo bancada usa: a base local onde o ensaio decide. -->
    <ProjectReference Include="../Access.Infrastructure.SQLite/Access.Infrastructure.SQLite.csproj" />
    <ProjectReference Include="../Topdata.EasyInner.Adapter/Topdata.EasyInner.Adapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O exemplo da bancada vai junto de qualquer publicação, e não só da feita pelo
         publicar.ps1: o pacote da bancada e o MSI da CI também precisam dele (docs/21). -->
    <None Include="../../installer/bancada.exemplo.json"
          Link="bancada.exemplo.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
