<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contrato do IPC local. Gera cliente e servidor a partir do .proto.
    Ver docs/ADR/ADR-0004-ipc-grpc-named-pipes.md
  -->
  <PropertyGroup>
    <!-- Código gerado pelo protoc não segue as regras de estilo do projeto. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1062;CA1812;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/edge_control.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unit.Tests" />
  </ItemGroup>

</Project>
