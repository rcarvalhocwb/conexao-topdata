<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Rayzer.Design">
  <!--
    Aparência padrão dos componentes Rayzer*. Só DynamicResource Rayzer.*: trocam de tema
    ao vivo e herdam o alto contraste.
  -->

  <!-- ===== RayzerStatus ===== -->
  <Style TargetType="{x:Type local:RayzerStatus}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Neutral}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Neutral.Subtle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerStatus}">
          <Border x:Name="Pilula" Background="Transparent" CornerRadius="{DynamicResource Rayzer.Radius.Pill}"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{DynamicResource Rayzer.Font.Symbols}"
                         FontWeight="Bold" Foreground="{TemplateBinding Foreground}"
                         Text="{Binding GlifoEfetivo, RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                         Text="{TemplateBinding Texto}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Pilula" Value="True">
              <Setter TargetName="Pilula" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Pilula" Property="Padding" Value="10,3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tom" Value="Sucesso">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Success}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Success.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Atencao">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Warning.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Perigo">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Danger.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Info}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Info.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Marca">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== RayzerMetricCard ===== -->
  <Style TargetType="{x:Type local:RayzerMetricCard}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Neutral}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Neutral.Subtle}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerMetricCard}">
          <Border Background="{DynamicResource Rayzer.Surface}" BorderBrush="{DynamicResource Rayzer.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource Rayzer.Radius.Lg}" Padding="{DynamicResource Rayzer.Padding.Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Rayzer.FontSize.Small}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{TemplateBinding Rotulo}" TextWrapping="Wrap" />
              <!-- Selo do ícone: fundo tingido e contorno na cor da situação (brand board, seção 09). -->
              <Grid Grid.Column="1" Width="32" Height="32" Margin="8,0,0,0" VerticalAlignment="Top">
                <Border CornerRadius="{DynamicResource Rayzer.Radius.Md}" Background="{TemplateBinding Background}" />
                <Border CornerRadius="{DynamicResource Rayzer.Radius.Md}" BorderThickness="1" Opacity="0.55"
                        BorderBrush="{TemplateBinding Foreground}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                           FontFamily="{DynamicResource Rayzer.Font.Icons}" Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Icone}" />
              </Grid>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" FontFamily="{DynamicResource Rayzer.Font.Display}"
                         FontSize="{DynamicResource Rayzer.FontSize.Metric}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Rayzer.Text.Primary}"
                         Text="{Binding Valor, RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="{DynamicResource Rayzer.FontSize.Caption}"
                         Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{TemplateBinding Detalhe}" TextWrapping="Wrap" />
              <!-- Linha de energia: a cor da situação, discreta, na base do cartão. -->
              <Border Grid.Row="3" Grid.ColumnSpan="2" Height="2" Width="40" Margin="0,12,0,0" HorizontalAlignment="Left"
                      CornerRadius="1" Background="{TemplateBinding Foreground}" Opacity="0.85" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tom" Value="Sucesso">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Success}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Success.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Atencao">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Warning.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Perigo">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Danger.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Info}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Info.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Marca">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== RayzerAlert ===== -->
  <Style TargetType="{x:Type local:RayzerAlert}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Info}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Info.Subtle}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerAlert}">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Rayzer.Radius.Md}"
                  BorderBrush="{TemplateBinding Foreground}" BorderThickness="4,0,0,0" Padding="14,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,10,0" VerticalAlignment="Top" FontFamily="{DynamicResource Rayzer.Font.Symbols}"
                         FontSize="16" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"
                         Text="{Binding Glifo, RelativeSource={RelativeSource TemplatedParent}}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Rayzer.FontSize.Small}" Foreground="{DynamicResource Rayzer.Text.Secondary}"
                           Text="{TemplateBinding Texto}" TextWrapping="Wrap" />
              </StackPanel>
              <ContentPresenter Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tom" Value="Sucesso">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Success}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Success.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Atencao">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Warning.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Perigo">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Danger.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Neutro">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Neutral}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Neutral.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Marca">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== RayzerEmptyState ===== -->
  <Style TargetType="{x:Type local:RayzerEmptyState}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerEmptyState}">
          <StackPanel MaxWidth="420" Margin="24">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
              <Ellipse Margin="1" Stroke="{DynamicResource Rayzer.Border}" StrokeThickness="1" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"
                         FontFamily="{DynamicResource Rayzer.Font.Icons}" Foreground="{DynamicResource Rayzer.Brand.Primary.Foreground}"
                         Text="{TemplateBinding Icone}" />
            </Grid>
            <TextBlock Margin="0,14,0,4" HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center"
                       FontSize="{DynamicResource Rayzer.FontSize.Section}"
                       Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}" TextWrapping="Wrap" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="{DynamicResource Rayzer.FontSize.Small}"
                       Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{TemplateBinding Texto}" TextWrapping="Wrap" />
            <TextBlock x:Name="Observacao" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="{DynamicResource Rayzer.FontSize.Caption}" Foreground="{DynamicResource Rayzer.Text.Tertiary}"
                       Text="{TemplateBinding Observacao}" TextWrapping="Wrap" />
            <ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Observacao" Value="">
              <Setter TargetName="Observacao" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerBrandMark: o X ===== -->
  <Style TargetType="{x:Type local:RayzerBrandMark}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerBrandMark}">
          <Viewbox Width="{TemplateBinding Tamanho}" Height="{TemplateBinding Tamanho}" AutomationProperties.Name="Símbolo Rayzer">
            <Canvas x:Name="Tela" Width="32" Height="32">
              <!-- A passagem: ciano no alto, prata embaixo, aberta no centro. -->
              <Path x:Name="PortaoAlto" Data="{DynamicResource Rayzer.Mark.GateUpper.Geometry}" Fill="{DynamicResource Rayzer.Mark.GateUpper}" />
              <Path x:Name="PortaoBaixo" Data="{DynamicResource Rayzer.Mark.GateLower.Geometry}" Fill="{DynamicResource Rayzer.Mark.GateLower}" />
              <!-- O fluxo: azul, contínuo, passa por cima. -->
              <Path x:Name="FluxoAlto" Data="{DynamicResource Rayzer.Mark.FlowUpper.Geometry}" Fill="{DynamicResource Rayzer.Mark.FlowUpper}" />
              <Path x:Name="FluxoBaixo" Data="{DynamicResource Rayzer.Mark.FlowLower.Geometry}" Fill="{DynamicResource Rayzer.Mark.FlowLower}" />
              <!-- Bevel: realce vítreo no alto de cada faixa. -->
              <Path x:Name="Realce1" Data="{DynamicResource Rayzer.Mark.FlowUpper.Geometry}" Fill="{DynamicResource Rayzer.Mark.Highlight}" />
              <Path x:Name="Realce2" Data="{DynamicResource Rayzer.Mark.GateUpper.Geometry}" Fill="{DynamicResource Rayzer.Mark.Highlight}" />
            </Canvas>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="Brilho" Value="True">
              <Setter TargetName="Tela" Property="Effect" Value="{DynamicResource Rayzer.Glow.Md}" />
            </Trigger>
            <Trigger Property="Monocromatico" Value="True">
              <Setter TargetName="PortaoAlto" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="PortaoBaixo" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="FluxoAlto" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="FluxoBaixo" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Realce1" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Realce2" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- marca:inicio -->
  <!-- ===== RayzerLogo: a marca corporativa RAYZER X (Rayzer Serviços e Tecnologia LTDA) ===== -->
  <Style TargetType="{x:Type local:RayzerLogo}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text.Active}" />
    <Setter Property="CorDeApoio" Value="{DynamicResource Rayzer.Nav.Text.Muted}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="Rayzer X — Serviços e Tecnologia" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerLogo}">
          <Grid>
          <Viewbox x:Name="Horizontal" Stretch="Uniform">
            <Canvas Width="593.55" Height="146.0">
              <Path Canvas.Left="0" Canvas.Top="27.74" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Rayzer}" />
              <local:RayzerBrandMark Canvas.Left="417.13" Canvas.Top="-24.33" Tamanho="194.67" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
              <Path Canvas.Left="0" Canvas.Top="125.56" Fill="{TemplateBinding CorDeApoio}" Data="{DynamicResource Rayzer.Letreiro.Descritor}"><Path.RenderTransform><ScaleTransform ScaleX="0.1824" ScaleY="0.1824" /></Path.RenderTransform></Path>
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="Simples" Stretch="Uniform" Visibility="Collapsed">
            <Canvas Width="593.55" Height="146.0">
              <Path Canvas.Left="0" Canvas.Top="27.74" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Rayzer}" />
              <local:RayzerBrandMark Canvas.Left="417.13" Canvas.Top="-24.33" Tamanho="194.67" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="Vertical" Stretch="Uniform" Visibility="Collapsed">
            <Canvas Width="423.7" Height="293.64">
              <local:RayzerBrandMark Canvas.Left="104.78" Canvas.Top="-26.77" Tamanho="214.13" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
              <Path Canvas.Left="0" Canvas.Top="182.5" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Rayzer}" />
              <Path Canvas.Left="0" Canvas.Top="280.32" Fill="{TemplateBinding CorDeApoio}" Data="{DynamicResource Rayzer.Letreiro.Descritor}"><Path.RenderTransform><ScaleTransform ScaleX="0.1824" ScaleY="0.1824" /></Path.RenderTransform></Path>
            </Canvas>
          </Viewbox>
          <local:RayzerBrandMark x:Name="Simbolo" Visibility="Collapsed" Tamanho="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                 Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Descritor" Value="False">
              <Setter TargetName="Horizontal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Simples" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Variante" Value="Vertical">
              <Setter TargetName="Horizontal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Simples" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Vertical" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Variante" Value="Simbolo">
              <Setter TargetName="Horizontal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Simples" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Simbolo" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== XAcessLogo: o produto XAcess (endosso "by RAYZER X") ===== -->
  <Style TargetType="{x:Type local:XAcessLogo}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="CorDeApoio" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="XAcess — Controle de acesso inteligente" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:XAcessLogo}">
          <Grid>
          <Viewbox x:Name="Principal" Stretch="Uniform">
            <Canvas Width="380.86" Height="124.16">
              <local:RayzerBrandMark Canvas.Left="-10.22" Canvas.Top="-13.63" Tamanho="109.01" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
              <Path Canvas.Left="90.76" Canvas.Top="7.3" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Acess}" />
              <Path Canvas.Left="0" Canvas.Top="113.88" Fill="{TemplateBinding CorDeApoio}" Data="{DynamicResource Rayzer.Letreiro.Tagline}"><Path.RenderTransform><ScaleTransform ScaleX="0.1408" ScaleY="0.1408" /></Path.RenderTransform></Path>
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="Assinatura" Stretch="Uniform" Visibility="Collapsed">
            <Canvas Width="380.86" Height="121.47">
              <local:RayzerBrandMark Canvas.Left="-10.22" Canvas.Top="-13.63" Tamanho="109.01" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
              <Path Canvas.Left="90.76" Canvas.Top="7.3" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Acess}" />
              <Path Canvas.Left="230.36" Canvas.Top="105.12" Fill="{TemplateBinding CorDeApoio}" Data="{DynamicResource Rayzer.Letreiro.By}"><Path.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Path.RenderTransform></Path>
              <Path Canvas.Left="265.1" Canvas.Top="105.12" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Rayzer}"><Path.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Path.RenderTransform></Path>
              <local:RayzerBrandMark Canvas.Left="354.4" Canvas.Top="95.92" Tamanho="29.2" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="Compacto" Stretch="Uniform" Visibility="Collapsed">
            <Canvas Width="380.86" Height="81.76">
              <local:RayzerBrandMark Canvas.Left="-10.22" Canvas.Top="-13.63" Tamanho="109.01" Brilho="{TemplateBinding Brilho}" Monocromatico="{TemplateBinding Monocromatico}" Foreground="{TemplateBinding Foreground}" />
              <Path Canvas.Left="90.76" Canvas.Top="7.3" Fill="{TemplateBinding Foreground}" Data="{DynamicResource Rayzer.Letreiro.Acess}" />
            </Canvas>
          </Viewbox>
          <local:RayzerAppIcon x:Name="Icone" Visibility="Collapsed" Width="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Variante" Value="ComAssinatura">
              <Setter TargetName="Principal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Assinatura" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Variante" Value="Compacto">
              <Setter TargetName="Principal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Compacto" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Variante" Value="Icone">
              <Setter TargetName="Principal" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Icone" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- marca:fim -->

  <!-- ===== RayzerAppIcon: ícone do aplicativo (quadro + X; com nome, "acess" embaixo) ===== -->
  <Style TargetType="{x:Type local:RayzerAppIcon}">
    <Setter Property="Width" Value="40" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="XAcess" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerAppIcon}">
          <Viewbox Stretch="Uniform">
            <Canvas Width="256" Height="256">
              <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56" StrokeThickness="6"
                         Fill="{DynamicResource Rayzer.AppIcon.Fundo}" Stroke="{DynamicResource Rayzer.AppIcon.Borda}" />
              <local:RayzerBrandMark x:Name="Simbolo" Canvas.Left="40" Canvas.Top="40" Tamanho="176" />
              <Path x:Name="Nome" Canvas.Left="53" Canvas.Top="159.87" Visibility="Collapsed"
                    Fill="{DynamicResource Rayzer.AppIcon.Texto}" Data="{DynamicResource Rayzer.Letreiro.Acess}">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="0.5171" ScaleY="0.5171" />
                </Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="ComNome" Value="True">
              <Setter TargetName="Simbolo" Property="Canvas.Left" Value="58.67" />
              <Setter TargetName="Simbolo" Property="Canvas.Top" Value="26.67" />
              <Setter TargetName="Simbolo" Property="Tamanho" Value="138.67" />
              <Setter TargetName="Nome" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerFlowBar ===== -->
  <Style TargetType="{x:Type local:RayzerFlowBar}">
    <Setter Property="Height" Value="3" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerFlowBar}">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Traco" HorizontalAlignment="Left" CornerRadius="2" Visibility="Hidden"
                    Background="{DynamicResource Rayzer.Energy}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerStatusPill ===== -->
  <Style TargetType="{x:Type local:RayzerStatusPill}" BasedOn="{StaticResource {x:Type local:RayzerStatus}}" />

  <!-- ===== RayzerStatusCard: bloco da barra operacional ===== -->
  <Style TargetType="{x:Type local:RayzerStatusCard}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Neutral}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Neutral.Subtle}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerStatusCard}">
          <Border Padding="12,8,14,8" CornerRadius="{DynamicResource Rayzer.Radius.Md}" Background="{DynamicResource Rayzer.Surface.Sunken}"
                  BorderBrush="{DynamicResource Rayzer.Border}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="30" Height="30" CornerRadius="{DynamicResource Rayzer.Radius.Md}" Background="{TemplateBinding Background}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           FontFamily="{DynamicResource Rayzer.Font.Icons}" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Icone}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="{DynamicResource Rayzer.FontSize.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}" />
                <TextBlock FontSize="{DynamicResource Rayzer.FontSize.Caption}" Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Descricao}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tom" Value="Sucesso">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Success}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Success.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Atencao">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Warning.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Perigo">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Danger.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Info}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Info.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Marca">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== RayzerPageHeader ===== -->
  <Style TargetType="{x:Type local:RayzerPageHeader}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerPageHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontFamily="{DynamicResource Rayzer.Font.Display}" FontSize="{DynamicResource Rayzer.FontSize.Display}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}" TextWrapping="Wrap" />
              <TextBlock Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left" FontSize="{DynamicResource Rayzer.FontSize.Body}"
                         Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{TemplateBinding Descricao}" TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerSectionHeader ===== -->
  <Style TargetType="{x:Type local:RayzerSectionHeader}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerSectionHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Linha de energia antes do título. -->
            <Border Width="3" Height="16" Margin="0,0,10,0" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Rayzer.Energy}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock FontFamily="{DynamicResource Rayzer.Font.Display}" FontSize="{DynamicResource Rayzer.FontSize.Section}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}" />
              <TextBlock x:Name="Sub" FontSize="{DynamicResource Rayzer.FontSize.Caption}" Foreground="{DynamicResource Rayzer.Text.Secondary}"
                         Text="{TemplateBinding Subtitulo}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Subtitulo" Value="">
              <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerDataPanel ===== -->
  <Style TargetType="{x:Type local:RayzerDataPanel}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerDataPanel}">
          <Border Background="{DynamicResource Rayzer.Surface}" BorderBrush="{DynamicResource Rayzer.Border}" BorderThickness="1"
                  CornerRadius="{DynamicResource Rayzer.Radius.Lg}">
            <DockPanel>
              <Grid x:Name="Cabecalho" DockPanel.Dock="Top" Margin="16,12,12,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontFamily="{DynamicResource Rayzer.Font.Display}" FontSize="{DynamicResource Rayzer.FontSize.Section}" FontWeight="SemiBold"
                             Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{TemplateBinding Titulo}" />
                  <TextBlock x:Name="Sub" FontSize="{DynamicResource Rayzer.FontSize.Caption}" Foreground="{DynamicResource Rayzer.Text.Secondary}"
                             Text="{TemplateBinding Subtitulo}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Ferramentas}" />
              </Grid>
              <ContentPresenter Margin="0" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Subtitulo" Value="">
              <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Titulo" Value="">
              <Setter TargetName="Cabecalho" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerMetaItem ===== -->
  <Style TargetType="{x:Type local:RayzerMetaItem}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerMetaItem}">
          <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
            <TextBlock VerticalAlignment="Center" Width="16" FontSize="12" FontFamily="{DynamicResource Rayzer.Font.Icons}"
                       Foreground="{DynamicResource Rayzer.Text.Tertiary}" Text="{TemplateBinding Icone}" />
            <TextBlock VerticalAlignment="Center" Margin="4,0,4,0" FontSize="{DynamicResource Rayzer.FontSize.Caption}"
                       Foreground="{DynamicResource Rayzer.Text.Secondary}" Text="{TemplateBinding Rotulo}" />
            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Rayzer.FontSize.Caption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Rayzer.Text.Primary}" Text="{Binding Valor, RelativeSource={RelativeSource TemplatedParent}}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RayzerTurnstileGlyph: a miniatura da catraca ===== -->
  <Style TargetType="{x:Type local:RayzerTurnstileGlyph}">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Neutral}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Neutral.Subtle}" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="72" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerTurnstileGlyph}">
          <Border CornerRadius="{DynamicResource Rayzer.Radius.Md}" Background="{DynamicResource Rayzer.Surface.Sunken}"
                  BorderBrush="{DynamicResource Rayzer.Border}" BorderThickness="1">
            <Viewbox Margin="6">
              <Canvas Width="32" Height="42">
                <!-- Braços do tripé. -->
                <Path Data="M19,17 L31,14 M19,17 L29,26 M19,17 L22,6" Stroke="{DynamicResource Rayzer.Text.Tertiary}"
                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <!-- Gabinete. -->
                <Border Canvas.Left="5" Canvas.Top="10" Width="14" Height="30" CornerRadius="2"
                        Background="{DynamicResource Rayzer.Surface}" BorderBrush="{DynamicResource Rayzer.Border.Strong}" BorderThickness="1" />
                <!-- Leitor com a luz da situação. -->
                <Border Canvas.Left="4" Canvas.Top="3" Width="16" Height="8" CornerRadius="2" Background="{DynamicResource Rayzer.Graphite}" />
                <Border Canvas.Left="7" Canvas.Top="6" Width="10" Height="2" CornerRadius="1" Background="{TemplateBinding Foreground}" />
                <Ellipse Canvas.Left="16.8" Canvas.Top="14.8" Width="4.4" Height="4.4" Fill="{DynamicResource Rayzer.Text.Tertiary}" />
              </Canvas>
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tom" Value="Sucesso">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Success}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Success.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Atencao">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Warning.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Perigo">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Danger.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Info}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Info.Subtle}" />
      </Trigger>
      <Trigger Property="Tom" Value="Marca">
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== RayzerAbertura: a abertura do aplicativo (brand board, seção 08) ===== -->
  <Style TargetType="{x:Type local:RayzerAbertura}">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="Abrindo o XAcess" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RayzerAbertura}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="Sequencia">
              <DoubleAnimation Storyboard.TargetName="FluxoA" Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" BeginTime="0:0:0" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="FluxoB" Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" BeginTime="0:0:0" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="FluxoC" Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" BeginTime="0:0:0" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="FluxoD" Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" BeginTime="0:0:0" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Fluxos" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:1.1" Duration="0:0:0.35" />
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pulso" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.95" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimation Storyboard.TargetName="Pulso" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.3" To="1.6" BeginTime="0:0:0.55" Duration="0:0:0.85"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Pulso" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1.6" BeginTime="0:0:0.55" Duration="0:0:0.85"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Simbolo" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimation Storyboard.TargetName="Simbolo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.82" To="1" BeginTime="0:0:1.4" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Simbolo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.82" To="1" BeginTime="0:0:1.4" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Marcas" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.85" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Linha" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" BeginTime="0:0:1.9" Duration="0:0:0.7"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:2.6" Duration="0:0:0.3" />
            </Storyboard>
          </ControlTemplate.Resources>
          <Grid x:Name="Raiz" Background="{DynamicResource Rayzer.Nav.Background}">
            <Viewbox MaxWidth="560" MaxHeight="360" Margin="32" Stretch="Uniform">
              <Canvas Width="520" Height="340">
                <!-- 1. Fluxos se aproximam: linhas de energia desenhadas até o centro. -->
                <Canvas x:Name="Fluxos" Effect="{DynamicResource Rayzer.Glow.Md}">
                  <Path x:Name="FluxoA" Data="M -20,250 C 120,250 180,170 260,170" Stroke="{DynamicResource Rayzer.Energy}"
                        StrokeThickness="3" StrokeDashArray="100 100" StrokeDashOffset="100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path x:Name="FluxoB" Data="M 540,90 C 400,90 340,170 260,170" Stroke="{DynamicResource Rayzer.Energy}"
                        StrokeThickness="3" StrokeDashArray="100 100" StrokeDashOffset="100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path x:Name="FluxoC" Data="M -20,205 C 130,205 190,170 260,170" Stroke="{DynamicResource Rayzer.Energy}" Opacity="0.45"
                        StrokeThickness="2" StrokeDashArray="150 150" StrokeDashOffset="100" StrokeStartLineCap="Round" />
                  <Path x:Name="FluxoD" Data="M 540,135 C 390,135 330,170 260,170" Stroke="{DynamicResource Rayzer.Energy}" Opacity="0.45"
                        StrokeThickness="2" StrokeDashArray="150 150" StrokeDashOffset="100" StrokeStartLineCap="Round" />
                </Canvas>
                <!-- 2. Interseção: o pulso Rayzer Access. -->
                <Ellipse x:Name="Pulso" Canvas.Left="140" Canvas.Top="50" Width="240" Height="240" Opacity="0"
                         Fill="{DynamicResource Rayzer.Abertura.Pulso}" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="0.3" ScaleY="0.3" />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <!-- 3. O símbolo se completa. -->
                <local:RayzerBrandMark x:Name="Simbolo" Canvas.Left="185" Canvas.Top="95" Tamanho="150" Brilho="True" Opacity="0"
                                       RenderTransformOrigin="0.5,0.5">
                  <local:RayzerBrandMark.RenderTransform>
                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                  </local:RayzerBrandMark.RenderTransform>
                </local:RayzerBrandMark>
                <!-- 4. Marca e produto. -->
                <StackPanel x:Name="Marcas" Canvas.Top="92" Width="520" Opacity="0">
                  <local:RayzerLogo Height="46" Descritor="False" Brilho="True" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Rayzer.Nav.Text.Active}" />
                  <local:XAcessLogo Variante="Compacto" Height="40" Margin="0,24,0,0" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Rayzer.Nav.Text.Active}" />
                  <Border x:Name="Linha" Width="170" Height="3" Margin="0,26,0,0" CornerRadius="1.5"
                          Background="{DynamicResource Rayzer.Energy}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="0" />
                    </Border.RenderTransform>
                  </Border>
                </StackPanel>
              </Canvas>
            </Viewbox>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
