<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <!--
    Rayzer — tokens que não mudam com o tema: tipografia, espaçamento, raio, elevação,
    movimento, pontos de quebra e ícones. As cores estão em Temas/*.xaml.

    Tipografia: Segoe UI Variable (Windows 11) com Segoe UI de reserva (Windows 10). Fonte do
    sistema de propósito: nada para baixar, nada para licenciar, renderização nativa e
    rápida. Números e horas em Cascadia Mono/Consolas: dígitos de largura fixa não "dançam"
    quando o contador muda.
  -->

  <!-- Famílias -->
  <FontFamily x:Key="Rayzer.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Rayzer.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Rayzer.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Rayzer.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Rayzer.Font.Symbols">Segoe UI Symbol, Segoe UI</FontFamily>

  <!-- Escala tipográfica (px) -->
  <sys:Double x:Key="Rayzer.FontSize.Metric">32</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Wordmark">20</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Display">26</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Title">20</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Section">15</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Small">13</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Rayzer.FontSize.Overline">11</sys:Double>

  <!-- Espaçamento: grade de 4 px -->
  <sys:Double x:Key="Rayzer.Space.1">4</sys:Double>
  <sys:Double x:Key="Rayzer.Space.2">8</sys:Double>
  <sys:Double x:Key="Rayzer.Space.3">12</sys:Double>
  <sys:Double x:Key="Rayzer.Space.4">16</sys:Double>
  <sys:Double x:Key="Rayzer.Space.5">24</sys:Double>
  <sys:Double x:Key="Rayzer.Space.6">32</sys:Double>
  <sys:Double x:Key="Rayzer.Space.7">40</sys:Double>
  <Thickness x:Key="Rayzer.Padding.Page">28,20,28,20</Thickness>
  <Thickness x:Key="Rayzer.Padding.Card">16,14,16,14</Thickness>
  <Thickness x:Key="Rayzer.Padding.Control">12,0,12,0</Thickness>
  <Thickness x:Key="Rayzer.Margin.Section">0,0,0,16</Thickness>
  <Thickness x:Key="Rayzer.Margin.Field">0,0,12,12</Thickness>

  <!-- Alturas: campos e botões da mesma linha com 40 px (alinham); 44 px no menu, alvo de toque -->
  <sys:Double x:Key="Rayzer.Height.Control">40</sys:Double>
  <sys:Double x:Key="Rayzer.Height.Touch">44</sys:Double>
  <sys:Double x:Key="Rayzer.Height.Row">36</sys:Double>

  <!-- Raio -->
  <CornerRadius x:Key="Rayzer.Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Rayzer.Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="Rayzer.Radius.Lg">12</CornerRadius>
  <CornerRadius x:Key="Rayzer.Radius.Pill">999</CornerRadius>

  <!--
    Elevação. Sombra custa renderização no WPF: só em superfície flutuante (popup, dica)
    e no cartão de métrica. O resto da hierarquia é feito com fundo e borda.
  -->
  <DropShadowEffect x:Key="Rayzer.Shadow.Sm" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#0B1A33" po:Freeze="True" />
  <DropShadowEffect x:Key="Rayzer.Shadow.Md" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#0B1A33" po:Freeze="True" />
  <DropShadowEffect x:Key="Rayzer.Shadow.Lg" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#0B1A33" po:Freeze="True" />

  <!--
    Movimento: a linguagem é fluxo — entrar, atravessar, conectar. Curto e sem quique.
    Nada de animação que atrase a operação: o estado muda na hora e o movimento só
    acompanha.
  -->
  <Duration x:Key="Rayzer.Motion.Fast">0:0:0.12</Duration>
  <Duration x:Key="Rayzer.Motion.Normal">0:0:0.20</Duration>
  <Duration x:Key="Rayzer.Motion.Flow">0:0:1.40</Duration>
  <Duration x:Key="Rayzer.Motion.Pulse">0:0:1.60</Duration>
  <CubicEase x:Key="Rayzer.Motion.Ease" EasingMode="EaseOut" po:Freeze="True" />

  <!-- Pontos de quebra (largura da janela, px) -->
  <sys:Double x:Key="Rayzer.Breakpoint.Compact">1200</sys:Double>
  <sys:Double x:Key="Rayzer.Breakpoint.Wide">1600</sys:Double>

  <!-- Ícones (Segoe Fluent Icons / Segoe MDL2 Assets, presentes no Windows 10 e 11) -->
  <sys:String x:Key="Rayzer.Icon.Home">&#xE80F;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Devices">&#xE772;</sys:String>
  <sys:String x:Key="Rayzer.Icon.List">&#xE8FD;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Search">&#xE721;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Sync">&#xE895;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Report">&#xE8A5;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Settings">&#xE713;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Diagnostic">&#xE9D9;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Play">&#xE768;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Calendar">&#xE787;</sys:String>
  <sys:String x:Key="Rayzer.Icon.ChevronDown">&#xE70D;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Check">&#xE73E;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Denied">&#xE711;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Collapse">&#xE700;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Sun">&#xE706;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Moon">&#xE708;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Cloud">&#xE753;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Info">&#xE946;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Warning">&#xE7BA;</sys:String>
  <sys:String x:Key="Rayzer.Icon.People">&#xE716;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Card">&#xE8C7;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Download">&#xE896;</sys:String>
  <sys:String x:Key="Rayzer.Icon.History">&#xE81C;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Clock">&#xE823;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Ethernet">&#xE839;</sys:String>
  <sys:String x:Key="Rayzer.Icon.Folder">&#xE8B7;</sys:String>

  <!--
    Símbolos de situação: nunca só cor. Cada situação tem cor + símbolo + texto.
    ✓ autorizado · × negado · ● online · ○ offline · ! atenção · ↻ sincronizando
  -->
  <sys:String x:Key="Rayzer.Glyph.Granted">✓</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Denied">×</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Online">●</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Offline">○</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Attention">!</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Syncing">↻</sys:String>
  <sys:String x:Key="Rayzer.Glyph.Synced">✓</sys:String>

  <!--
    O símbolo Rayzer (brand board, "construção do símbolo"): duas faixas em fluxo que se
    encontram e formam o X. A faixa do fluxo (\) é contínua e passa por cima; a faixa da
    passagem (/) se abre para ela passar. "Acesso é um fluxo, não uma porta." Grade 32 × 32,
    terminais horizontais.
  -->
  <Geometry x:Key="Rayzer.Mark.FlowUpper.Geometry">M3,4 L11,4 L20,16 L12,16 Z</Geometry>
  <Geometry x:Key="Rayzer.Mark.FlowLower.Geometry">M12,16 L20,16 L29,28 L21,28 Z</Geometry>
  <Geometry x:Key="Rayzer.Mark.GateUpper.Geometry">M21,4 L29,4 L20.75,15 L16.75,9.67 Z</Geometry>
  <Geometry x:Key="Rayzer.Mark.GateLower.Geometry">M11,28 L3,28 L11.25,17 L15.25,22.33 Z</Geometry>
  <Geometry x:Key="Rayzer.Logo.Flow.Geometry">M3,4 L11,4 L29,28 L21,28 Z</Geometry>
  <Geometry x:Key="Rayzer.Logo.Gate.Geometry">M21,4 L29,4 L20.75,15 L16.75,9.67 Z M11,28 L3,28 L11.25,17 L15.25,22.33 Z</Geometry>

  <!--
    Material do X: vítreo e tecnológico, sem plástico. Cada braço com o seu gradiente
    (o azul do fluxo escurece para baixo; a passagem vai do ciano ao prata), um realce de
    bevel no alto e o brilho azul só na variante "glow". Cores de marca: iguais nos dois
    temas.
  -->
  <LinearGradientBrush x:Key="Rayzer.Mark.FlowUpper" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#4D94FF" />
    <GradientStop Offset="1" Color="#0066FF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Rayzer.Mark.FlowLower" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#0066FF" />
    <GradientStop Offset="1" Color="#003FBF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Rayzer.Mark.GateUpper" StartPoint="1,0" EndPoint="0,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#8AF0FF" />
    <GradientStop Offset="0.55" Color="#00D5FF" />
    <GradientStop Offset="1" Color="#009FE0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Rayzer.Mark.GateLower" StartPoint="1,0" EndPoint="0,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#F4F7FB" />
    <GradientStop Offset="1" Color="#8A9BB0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Rayzer.Mark.Highlight" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#66FFFFFF" />
    <GradientStop Offset="0.45" Color="#00FFFFFF" />
  </LinearGradientBrush>

  <!-- Brilho azul controlado: corporativo, nunca neon. -->
  <DropShadowEffect x:Key="Rayzer.Glow.Sm" BlurRadius="10" ShadowDepth="0" Opacity="0.35" Color="#0066FF" po:Freeze="True" />
  <DropShadowEffect x:Key="Rayzer.Glow.Md" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#0066FF" po:Freeze="True" />
</ResourceDictionary>
