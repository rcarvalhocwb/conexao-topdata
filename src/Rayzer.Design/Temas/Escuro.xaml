<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <!--
    Rayzer — tema escuro operacional, para sala de controle e evento noturno. Sem preto
    absoluto (o fundo é azul-noite #0B121C) e sem neon: as cores de situação são dessaturadas
    o bastante para não cansar em horas de monitoramento, e ainda passam em 4,5:1.
  -->
  <!-- Fundo da janela, atrás de tudo -->
  <SolidColorBrush x:Key="Rayzer.Background" Color="#0B121C" po:Freeze="True" />
  <!-- Superfície de conteúdo: cartões, tabelas -->
  <SolidColorBrush x:Key="Rayzer.Surface" Color="#111B28" po:Freeze="True" />
  <!-- Superfície elevada: menus, popups, dicas -->
  <SolidColorBrush x:Key="Rayzer.Surface.Elevated" Color="#172334" po:Freeze="True" />
  <!-- Superfície rebaixada: cabeçalho de tabela, linha alternada -->
  <SolidColorBrush x:Key="Rayzer.Surface.Sunken" Color="#0E1723" po:Freeze="True" />
  <!-- Item sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Surface.Hover" Color="#1A2738" po:Freeze="True" />
  <!-- Item selecionado -->
  <SolidColorBrush x:Key="Rayzer.Surface.Selected" Color="#1B2B47" po:Freeze="True" />
  <!-- Borda discreta -->
  <SolidColorBrush x:Key="Rayzer.Border" Color="#243246" po:Freeze="True" />
  <!-- Borda de destaque -->
  <SolidColorBrush x:Key="Rayzer.Border.Strong" Color="#33445C" po:Freeze="True" />
  <!-- Fundo de campo -->
  <SolidColorBrush x:Key="Rayzer.Input.Background" Color="#0E1723" po:Freeze="True" />
  <!-- Borda de campo (contraste mínimo 3:1) -->
  <SolidColorBrush x:Key="Rayzer.Input.Border" Color="#6A7C96" po:Freeze="True" />
  <!-- Anel de foco do teclado -->
  <SolidColorBrush x:Key="Rayzer.Focus" Color="#8AA3FF" po:Freeze="True" />
  <!-- Texto principal -->
  <SolidColorBrush x:Key="Rayzer.Text.Primary" Color="#E7EDF6" po:Freeze="True" />
  <!-- Texto de apoio (contraste mínimo 4,5:1) -->
  <SolidColorBrush x:Key="Rayzer.Text.Secondary" Color="#9AA8BC" po:Freeze="True" />
  <!-- Texto desabilitado -->
  <SolidColorBrush x:Key="Rayzer.Text.Disabled" Color="#5F6E84" po:Freeze="True" />
  <!-- Texto sobre a cor da marca -->
  <SolidColorBrush x:Key="Rayzer.Text.OnBrand" Color="#FFFFFF" po:Freeze="True" />
  <!-- Azul Fluxo: preenchimento da ação principal -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary" Color="#3358E8" po:Freeze="True" />
  <!-- Ação principal sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Hover" Color="#4468F0" po:Freeze="True" />
  <!-- Ação principal pressionada -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Pressed" Color="#2A4BD0" po:Freeze="True" />
  <!-- Azul Fluxo como texto ou ícone sobre superfície -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Foreground" Color="#8AA3FF" po:Freeze="True" />
  <!-- Fundo tingido da marca -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Subtle" Color="#172447" po:Freeze="True" />
  <!-- Azul Noite: a base institucional -->
  <SolidColorBrush x:Key="Rayzer.Brand.Secondary" Color="#1B3252" po:Freeze="True" />
  <!-- Verde Passagem: o acento do fluxo -->
  <SolidColorBrush x:Key="Rayzer.Brand.Accent" Color="#36CFC6" po:Freeze="True" />
  <!-- Sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success" Color="#4CC27A" po:Freeze="True" />
  <!-- Fundo de sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success.Subtle" Color="#12301F" po:Freeze="True" />
  <!-- Atenção -->
  <SolidColorBrush x:Key="Rayzer.Warning" Color="#F0A83C" po:Freeze="True" />
  <!-- Fundo de atenção -->
  <SolidColorBrush x:Key="Rayzer.Warning.Subtle" Color="#36270F" po:Freeze="True" />
  <!-- Perigo, exige ação -->
  <SolidColorBrush x:Key="Rayzer.Danger" Color="#F07373" po:Freeze="True" />
  <!-- Fundo de perigo -->
  <SolidColorBrush x:Key="Rayzer.Danger.Subtle" Color="#3A1A1D" po:Freeze="True" />
  <!-- Informação -->
  <SolidColorBrush x:Key="Rayzer.Info" Color="#6AA8F5" po:Freeze="True" />
  <!-- Fundo de informação -->
  <SolidColorBrush x:Key="Rayzer.Info.Subtle" Color="#13263F" po:Freeze="True" />
  <!-- Neutro: parado, desligado, sem dado -->
  <SolidColorBrush x:Key="Rayzer.Neutral" Color="#8A97AB" po:Freeze="True" />
  <!-- Fundo neutro -->
  <SolidColorBrush x:Key="Rayzer.Neutral.Subtle" Color="#1A2433" po:Freeze="True" />
  <!-- ✓ Acesso autorizado -->
  <SolidColorBrush x:Key="Rayzer.Access.Granted" Color="#4CC27A" po:Freeze="True" />
  <!-- × Acesso negado -->
  <SolidColorBrush x:Key="Rayzer.Access.Denied" Color="#F07373" po:Freeze="True" />
  <!-- ● Dispositivo online -->
  <SolidColorBrush x:Key="Rayzer.Device.Online" Color="#4CC27A" po:Freeze="True" />
  <!-- ○ Dispositivo offline -->
  <SolidColorBrush x:Key="Rayzer.Device.Offline" Color="#F07373" po:Freeze="True" />
  <!-- ! Dispositivo com atenção -->
  <SolidColorBrush x:Key="Rayzer.Device.Warning" Color="#F0A83C" po:Freeze="True" />
  <!-- ↻ Sincronizando -->
  <SolidColorBrush x:Key="Rayzer.Syncing" Color="#6AA8F5" po:Freeze="True" />
  <!-- Barra lateral: Azul Noite nos dois temas -->
  <SolidColorBrush x:Key="Rayzer.Nav.Background" Color="#08101A" po:Freeze="True" />
  <!-- Texto da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text" Color="#AEBBD0" po:Freeze="True" />
  <!-- Texto do item ativo -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Active" Color="#FFFFFF" po:Freeze="True" />
  <!-- Legenda na barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Muted" Color="#7D8BA1" po:Freeze="True" />
  <!-- Item da barra sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Hover" Color="#101C2B" po:Freeze="True" />
  <!-- Item ativo da barra -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Active" Color="#16243A" po:Freeze="True" />
  <!-- Linha de fluxo do item ativo -->
  <SolidColorBrush x:Key="Rayzer.Nav.Indicator" Color="#36CFC6" po:Freeze="True" />
  <!-- Divisória da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Divider" Color="#182538" po:Freeze="True" />
  <!-- Símbolo: a barra do fluxo -->
  <SolidColorBrush x:Key="Rayzer.Logo.Flow" Color="#5C80FF" po:Freeze="True" />
  <!-- Símbolo: a passagem -->
  <SolidColorBrush x:Key="Rayzer.Logo.Gate" Color="#36CFC6" po:Freeze="True" />
  <!-- Barra de rolagem -->
  <SolidColorBrush x:Key="Rayzer.Scrollbar.Thumb" Color="#33445C" po:Freeze="True" />
  <!-- Cor da sombra -->
  <SolidColorBrush x:Key="Rayzer.Shadow" Color="#000000" po:Freeze="True" />
</ResourceDictionary>
