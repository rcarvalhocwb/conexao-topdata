<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <!--
    Rayzer XAcess — tema escuro, a expressão principal da marca no brand board (paleta):
    Fundo principal #0B1A33, Superfície elevada #111827, Azul Principal #0066FF, Ciano
    #00D5FF no brilho e na linha de energia, Cinza #8A9BB0 no texto secundário, Sucesso
    operacional #32D583, Atenção/Simulação #F5A524 e Erro/Negado #F05252 — todos em 4,5:1
    sobre as superfícies.
  -->
  <!-- Fundo: Branco Rayzer (claro) / azul profundo (escuro) -->
  <SolidColorBrush x:Key="Rayzer.Background" Color="#0B1A33" po:Freeze="True" />
  <!-- Superfície de conteúdo: cartões, tabelas -->
  <SolidColorBrush x:Key="Rayzer.Surface" Color="#111827" po:Freeze="True" />
  <!-- Superfície elevada: menus, popups, dicas -->
  <SolidColorBrush x:Key="Rayzer.Surface.Elevated" Color="#172235" po:Freeze="True" />
  <!-- Superfície rebaixada: cabeçalho de tabela, bloco técnico -->
  <SolidColorBrush x:Key="Rayzer.Surface.Sunken" Color="#0D1526" po:Freeze="True" />
  <!-- Item sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Surface.Hover" Color="#172236" po:Freeze="True" />
  <!-- Item selecionado -->
  <SolidColorBrush x:Key="Rayzer.Surface.Selected" Color="#10336B" po:Freeze="True" />
  <!-- Borda discreta -->
  <SolidColorBrush x:Key="Rayzer.Border" Color="#22304A" po:Freeze="True" />
  <!-- Borda de destaque -->
  <SolidColorBrush x:Key="Rayzer.Border.Strong" Color="#314262" po:Freeze="True" />
  <!-- Divisória entre grupos -->
  <SolidColorBrush x:Key="Rayzer.Border.Subtle" Color="#1A2640" po:Freeze="True" />
  <!-- Fundo de campo -->
  <SolidColorBrush x:Key="Rayzer.Input.Background" Color="#0D1526" po:Freeze="True" />
  <!-- Borda de campo (contraste mínimo 3:1) -->
  <SolidColorBrush x:Key="Rayzer.Input.Border" Color="#5A6D8F" po:Freeze="True" />
  <!-- Anel de foco do teclado -->
  <SolidColorBrush x:Key="Rayzer.Focus" Color="#33A0FF" po:Freeze="True" />
  <!-- Véu atrás de diálogo -->
  <SolidColorBrush x:Key="Rayzer.Overlay" Color="#B3060E1C" po:Freeze="True" />
  <!-- Texto principal -->
  <SolidColorBrush x:Key="Rayzer.Text.Primary" Color="#F4F7FB" po:Freeze="True" />
  <!-- Texto de apoio (contraste mínimo 4,5:1) -->
  <SolidColorBrush x:Key="Rayzer.Text.Secondary" Color="#8A9BB0" po:Freeze="True" />
  <!-- Texto técnico e legenda longa (só tamanho 12+) -->
  <SolidColorBrush x:Key="Rayzer.Text.Tertiary" Color="#74879F" po:Freeze="True" />
  <!-- Texto desabilitado -->
  <SolidColorBrush x:Key="Rayzer.Text.Disabled" Color="#4E607A" po:Freeze="True" />
  <!-- Texto sobre a cor da marca -->
  <SolidColorBrush x:Key="Rayzer.Text.OnBrand" Color="#FFFFFF" po:Freeze="True" />
  <!-- Azul Principal #0066FF: preenchimento da ação principal -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary" Color="#0066FF" po:Freeze="True" />
  <!-- Ação principal sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Hover" Color="#0058E0" po:Freeze="True" />
  <!-- Ação principal pressionada -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Pressed" Color="#0052CC" po:Freeze="True" />
  <!-- Azul como texto ou ícone sobre superfície -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Foreground" Color="#5A9BFF" po:Freeze="True" />
  <!-- Fundo tingido da marca -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Subtle" Color="#0D2A57" po:Freeze="True" />
  <!-- Azul Escuro #0B1A33: a base institucional -->
  <SolidColorBrush x:Key="Rayzer.Brand.Secondary" Color="#0B1A33" po:Freeze="True" />
  <!-- Ciano como texto/ícone (escurecido no claro para contraste) -->
  <SolidColorBrush x:Key="Rayzer.Brand.Accent" Color="#00D5FF" po:Freeze="True" />
  <!-- Ciano #00D5FF: brilho, linha de energia, indicador -->
  <SolidColorBrush x:Key="Rayzer.Brand.Cyan" Color="#00D5FF" po:Freeze="True" />
  <!-- Superfície elevada #111827 (brand board, paleta) -->
  <SolidColorBrush x:Key="Rayzer.Graphite" Color="#111827" po:Freeze="True" />
  <!-- Brilho azul sutil (fundo translúcido) -->
  <SolidColorBrush x:Key="Rayzer.Glow.Blue" Color="#590066FF" po:Freeze="True" />
  <!-- Sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success" Color="#32D583" po:Freeze="True" />
  <!-- Fundo de sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success.Subtle" Color="#0D2B24" po:Freeze="True" />
  <!-- Atenção, modo simulação -->
  <SolidColorBrush x:Key="Rayzer.Warning" Color="#F5A524" po:Freeze="True" />
  <!-- Fundo de atenção -->
  <SolidColorBrush x:Key="Rayzer.Warning.Subtle" Color="#33260C" po:Freeze="True" />
  <!-- Perigo, exige ação -->
  <SolidColorBrush x:Key="Rayzer.Danger" Color="#F05252" po:Freeze="True" />
  <!-- Fundo de perigo -->
  <SolidColorBrush x:Key="Rayzer.Danger.Subtle" Color="#33131C" po:Freeze="True" />
  <!-- Informação -->
  <SolidColorBrush x:Key="Rayzer.Info" Color="#4DB8FF" po:Freeze="True" />
  <!-- Fundo de informação -->
  <SolidColorBrush x:Key="Rayzer.Info.Subtle" Color="#0D2B47" po:Freeze="True" />
  <!-- Neutro: parado, desligado, sem dado -->
  <SolidColorBrush x:Key="Rayzer.Neutral" Color="#8A9BB0" po:Freeze="True" />
  <!-- Fundo neutro -->
  <SolidColorBrush x:Key="Rayzer.Neutral.Subtle" Color="#1A2436" po:Freeze="True" />
  <!-- ✓ Acesso autorizado -->
  <SolidColorBrush x:Key="Rayzer.Access.Granted" Color="#32D583" po:Freeze="True" />
  <!-- × Acesso negado -->
  <SolidColorBrush x:Key="Rayzer.Access.Denied" Color="#F05252" po:Freeze="True" />
  <!-- ● Dispositivo online -->
  <SolidColorBrush x:Key="Rayzer.Device.Online" Color="#32D583" po:Freeze="True" />
  <!-- ○ Dispositivo offline -->
  <SolidColorBrush x:Key="Rayzer.Device.Offline" Color="#F05252" po:Freeze="True" />
  <!-- ! Dispositivo com atenção -->
  <SolidColorBrush x:Key="Rayzer.Device.Warning" Color="#F5A524" po:Freeze="True" />
  <!-- ↻ Sincronizando -->
  <SolidColorBrush x:Key="Rayzer.Syncing" Color="#4DB8FF" po:Freeze="True" />
  <!-- Barra lateral: Azul Escuro nos dois temas -->
  <SolidColorBrush x:Key="Rayzer.Nav.Background" Color="#07101F" po:Freeze="True" />
  <!-- Texto da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text" Color="#B7C4D8" po:Freeze="True" />
  <!-- Texto do item ativo -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Active" Color="#FFFFFF" po:Freeze="True" />
  <!-- Legenda na barra lateral (Cinza #8A9BB0) -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Muted" Color="#7F90A8" po:Freeze="True" />
  <!-- Item da barra sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Hover" Color="#0F1C33" po:Freeze="True" />
  <!-- Item ativo da barra -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Active" Color="#112A4F" po:Freeze="True" />
  <!-- Linha de energia do item ativo (Ciano) -->
  <SolidColorBrush x:Key="Rayzer.Nav.Indicator" Color="#00D5FF" po:Freeze="True" />
  <!-- Divisória da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Divider" Color="#15223A" po:Freeze="True" />
  <!-- Símbolo: a faixa do fluxo (Azul Principal) -->
  <SolidColorBrush x:Key="Rayzer.Logo.Flow" Color="#0066FF" po:Freeze="True" />
  <!-- Símbolo: a faixa da passagem (Ciano) -->
  <SolidColorBrush x:Key="Rayzer.Logo.Gate" Color="#00D5FF" po:Freeze="True" />
  <!-- Barra de rolagem -->
  <SolidColorBrush x:Key="Rayzer.Scrollbar.Thumb" Color="#2C4468" po:Freeze="True" />
  <!-- Cor da sombra -->
  <SolidColorBrush x:Key="Rayzer.Shadow" Color="#000000" po:Freeze="True" />
  <!-- Linha de energia: gradiente Azul Principal → Ciano (indicadores, KPI, barra de carregamento) -->
  <LinearGradientBrush x:Key="Rayzer.Energy" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
    <GradientStop Offset="0" Color="#0066FF" />
    <GradientStop Offset="1" Color="#00D5FF" />
  </LinearGradientBrush>
</ResourceDictionary>
