<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <!--
    Rayzer — alto contraste. Com o alto contraste do Windows ligado, a marca cede: toda
    chave aponta para as cores de sistema escolhidas pela pessoa. A situação continua
    legível porque nunca depende só da cor (sempre ícone + texto).
  -->
  <!-- Fundo da janela, atrás de tudo -->
  <SolidColorBrush x:Key="Rayzer.Background" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Superfície de conteúdo: cartões, tabelas -->
  <SolidColorBrush x:Key="Rayzer.Surface" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Superfície elevada: menus, popups, dicas -->
  <SolidColorBrush x:Key="Rayzer.Surface.Elevated" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Superfície rebaixada: cabeçalho de tabela, linha alternada -->
  <SolidColorBrush x:Key="Rayzer.Surface.Sunken" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Item sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Surface.Hover" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Item selecionado -->
  <SolidColorBrush x:Key="Rayzer.Surface.Selected" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Borda discreta -->
  <SolidColorBrush x:Key="Rayzer.Border" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Borda de destaque -->
  <SolidColorBrush x:Key="Rayzer.Border.Strong" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo de campo -->
  <SolidColorBrush x:Key="Rayzer.Input.Background" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Borda de campo (contraste mínimo 3:1) -->
  <SolidColorBrush x:Key="Rayzer.Input.Border" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Anel de foco do teclado -->
  <SolidColorBrush x:Key="Rayzer.Focus" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Texto principal -->
  <SolidColorBrush x:Key="Rayzer.Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Texto de apoio (contraste mínimo 4,5:1) -->
  <SolidColorBrush x:Key="Rayzer.Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Texto desabilitado -->
  <SolidColorBrush x:Key="Rayzer.Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" po:Freeze="True" />
  <!-- Texto sobre a cor da marca -->
  <SolidColorBrush x:Key="Rayzer.Text.OnBrand" Color="{x:Static SystemColors.HighlightTextColor}" po:Freeze="True" />
  <!-- Azul Fluxo: preenchimento da ação principal -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Ação principal sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Hover" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Ação principal pressionada -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Pressed" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Azul Fluxo como texto ou ícone sobre superfície -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Foreground" Color="{x:Static SystemColors.HotTrackColor}" po:Freeze="True" />
  <!-- Fundo tingido da marca -->
  <SolidColorBrush x:Key="Rayzer.Brand.Primary.Subtle" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Azul Noite: a base institucional -->
  <SolidColorBrush x:Key="Rayzer.Brand.Secondary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Verde Passagem: o acento do fluxo -->
  <SolidColorBrush x:Key="Rayzer.Brand.Accent" Color="{x:Static SystemColors.HotTrackColor}" po:Freeze="True" />
  <!-- Sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo de sucesso -->
  <SolidColorBrush x:Key="Rayzer.Success.Subtle" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Atenção -->
  <SolidColorBrush x:Key="Rayzer.Warning" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo de atenção -->
  <SolidColorBrush x:Key="Rayzer.Warning.Subtle" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Perigo, exige ação -->
  <SolidColorBrush x:Key="Rayzer.Danger" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo de perigo -->
  <SolidColorBrush x:Key="Rayzer.Danger.Subtle" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Informação -->
  <SolidColorBrush x:Key="Rayzer.Info" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo de informação -->
  <SolidColorBrush x:Key="Rayzer.Info.Subtle" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- Neutro: parado, desligado, sem dado -->
  <SolidColorBrush x:Key="Rayzer.Neutral" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Fundo neutro -->
  <SolidColorBrush x:Key="Rayzer.Neutral.Subtle" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True" />
  <!-- ✓ Acesso autorizado -->
  <SolidColorBrush x:Key="Rayzer.Access.Granted" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- × Acesso negado -->
  <SolidColorBrush x:Key="Rayzer.Access.Denied" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- ● Dispositivo online -->
  <SolidColorBrush x:Key="Rayzer.Device.Online" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- ○ Dispositivo offline -->
  <SolidColorBrush x:Key="Rayzer.Device.Offline" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- ! Dispositivo com atenção -->
  <SolidColorBrush x:Key="Rayzer.Device.Warning" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- ↻ Sincronizando -->
  <SolidColorBrush x:Key="Rayzer.Syncing" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
  <!-- Barra lateral: Azul Noite nos dois temas -->
  <SolidColorBrush x:Key="Rayzer.Nav.Background" Color="{x:Static SystemColors.ControlColor}" po:Freeze="True" />
  <!-- Texto da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text" Color="{x:Static SystemColors.ControlTextColor}" po:Freeze="True" />
  <!-- Texto do item ativo -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Active" Color="{x:Static SystemColors.HighlightTextColor}" po:Freeze="True" />
  <!-- Legenda na barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Text.Muted" Color="{x:Static SystemColors.GrayTextColor}" po:Freeze="True" />
  <!-- Item da barra sob o mouse -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Hover" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Item ativo da barra -->
  <SolidColorBrush x:Key="Rayzer.Nav.Item.Active" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Linha de fluxo do item ativo -->
  <SolidColorBrush x:Key="Rayzer.Nav.Indicator" Color="{x:Static SystemColors.HighlightTextColor}" po:Freeze="True" />
  <!-- Divisória da barra lateral -->
  <SolidColorBrush x:Key="Rayzer.Nav.Divider" Color="{x:Static SystemColors.ControlTextColor}" po:Freeze="True" />
  <!-- Símbolo: a barra do fluxo -->
  <SolidColorBrush x:Key="Rayzer.Logo.Flow" Color="{x:Static SystemColors.HotTrackColor}" po:Freeze="True" />
  <!-- Símbolo: a passagem -->
  <SolidColorBrush x:Key="Rayzer.Logo.Gate" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True" />
  <!-- Barra de rolagem -->
  <SolidColorBrush x:Key="Rayzer.Scrollbar.Thumb" Color="{x:Static SystemColors.ControlDarkColor}" po:Freeze="True" />
  <!-- Cor da sombra -->
  <SolidColorBrush x:Key="Rayzer.Shadow" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True" />
</ResourceDictionary>
