<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Rayzer — estilos dos controles. Toda cor vem de DynamicResource Rayzer.* (troca de tema
    ao vivo); nenhum valor de cor aparece aqui. Estados: normal, sob o mouse, pressionado,
    foco de teclado (anel visível), desabilitado. Sem animação nos controles: a resposta
    ao clique é instantânea — velocidade é a prioridade da operação.

    Regra: nenhum estilo implícito de TextBlock. No WPF ele vazaria para dentro dos
    templates (texto branco do botão principal, por exemplo). A cor e a fonte do texto
    vêm da janela (Rayzer.Janela) por herança.
  -->

  <!-- ===== Foco de teclado ===== -->
  <Style x:Key="Rayzer.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                     Stroke="{DynamicResource Rayzer.Focus}" StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Janela ===== -->
  <Style x:Key="Rayzer.Janela" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ===== Texto ===== -->
  <Style x:Key="Rayzer.Type.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Rayzer.Type.Section" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="Rayzer.Type.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Rayzer.Type.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Rayzer.Type.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Rayzer.Type.Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Overline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
  </Style>

  <!-- Rótulo de campo de formulário. -->
  <Style x:Key="Rayzer.Type.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Rayzer.Type.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Metric}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
  </Style>

  <!-- Horas, códigos mascarados e linhas de registro: dígitos de largura fixa. -->
  <Style x:Key="Rayzer.Type.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
  </Style>

  <Style x:Key="Rayzer.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ===== Superfícies ===== -->
  <Style x:Key="Rayzer.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Rayzer.Radius.Lg}" />
    <Setter Property="Padding" Value="{DynamicResource Rayzer.Padding.Card}" />
  </Style>

  <Style x:Key="Rayzer.Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="Margin" Value="0,12,0,12" />
  </Style>

  <!-- ===== Botões ===== -->
  <ControlTemplate x:Key="Rayzer.Button.Template" TargetType="ButtonBase">
    <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Rayzer.Radius.Md}"
            SnapsToDevicePixels="True">
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Border>
  </ControlTemplate>

  <!-- Secundário: o botão padrão. -->
  <Style TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Rayzer.Button.Template}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rayzer.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Rayzer.Height.Control}" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Selected}" />
      </Trigger>
      <!--
        Desabilitado com cor própria, não com opacidade: a 50 %, o botão fantasma continuava
        azul e parecia link, e o principal continuava azul no tema escuro (docs/34 §7.1, P12).
        Cinza liso, texto desabilitado e sem a mãozinha. O último gatilho vence: fica no fim.
      -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Rayzer.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.OnBrand}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Brand.Primary.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Brand.Primary.Pressed}" />
      </Trigger>
      <!-- Repetido aqui porque os gatilhos deste estilo vêm depois dos do botão base. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Rayzer.Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Selected}" />
      </Trigger>
      <!--
        Fantasma desabilitado vira uma etiqueta cinza lisa: sem o azul de link, o operador não
        tenta clicar em "Bip curto e longo" (docs/34 §7.1, P12).
      -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Surface.Disabled}" />
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Só ícone (calendário, recolher barra). -->
  <Style x:Key="Rayzer.Button.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Icons}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Botão sobre a barra lateral Azul Noite. -->
  <Style x:Key="Rayzer.Button.Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Nav.Item.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text.Active}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Nav.Item.Active}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Rayzer.ToggleButton.Nav" TargetType="ToggleButton">
    <Setter Property="Template" Value="{StaticResource Rayzer.Button.Template}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Rayzer.FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Rayzer.Font.Icons}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Nav.Item.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text.Active}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Campos ===== -->
  <ControlTemplate x:Key="Rayzer.Input.Template" TargetType="Control">
    <Border x:Name="Borda" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Rayzer.Radius.Sm}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
    </Border>
  </ControlTemplate>

  <Style x:Key="Rayzer.Input.Base" TargetType="Control">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Input.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Rayzer.Height.Control}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Text.Secondary}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Focus}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="9,0" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Rayzer.Input.Base}">
    <Setter Property="Template" Value="{StaticResource Rayzer.Input.Template}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource Rayzer.Input.Base}">
    <Setter Property="Template" Value="{StaticResource Rayzer.Input.Template}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
  </Style>

  <!-- ===== Lista de seleção ===== -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fundo" Background="Transparent" CornerRadius="{DynamicResource Rayzer.Radius.Sm}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource Rayzer.Input.Base}">
    <Setter Property="Padding" Value="10,0,36,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <ToggleButton Focusable="False" ClickMode="Press"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Rayzer.Radius.Sm}">
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                               FontFamily="{DynamicResource Rayzer.Font.Icons}" Text="{DynamicResource Rayzer.Icon.ChevronDown}"
                               Foreground="{DynamicResource Rayzer.Text.Secondary}" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                              HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Margin="0,4,12,12" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{DynamicResource Rayzer.Surface.Elevated}" BorderBrush="{DynamicResource Rayzer.Border}"
                      BorderThickness="1" CornerRadius="{DynamicResource Rayzer.Radius.Md}" Effect="{DynamicResource Rayzer.Shadow.Md}">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- A borda de foco engrossa 1 px: o recuo desconta 1 px e mantém a folga da setinha. -->
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Padding" Value="9,0,35,0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Data ===== -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="WatermarkStates">
                <VisualState x:Name="Unwatermarked" />
                <VisualState x:Name="Watermarked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_ContentHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentControl x:Name="PART_Watermark" Opacity="0" Focusable="False" IsHitTestVisible="False"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                            Foreground="{DynamicResource Rayzer.Text.Secondary}" />
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker" BasedOn="{StaticResource Rayzer.Input.Base}">
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Rayzer.Radius.Sm}">
            <Grid x:Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Padding="{TemplateBinding Padding}" VerticalContentAlignment="Center" />
              <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource Rayzer.Button.Icon}" Focusable="False"
                      Content="{DynamicResource Rayzer.Icon.Calendar}" AutomationProperties.Name="Abrir calendário" />
              <Popup x:Name="PART_Popup" Grid.Column="0" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                     PlacementTarget="{Binding ElementName=PART_TextBox}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Caixa de marcar ===== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Caixa" Width="20" Height="20" VerticalAlignment="Center" CornerRadius="{DynamicResource Rayzer.Radius.Sm}"
                    BorderThickness="1.5" BorderBrush="{DynamicResource Rayzer.Input.Border}" Background="{DynamicResource Rayzer.Input.Background}">
              <TextBlock x:Name="Marca" Visibility="Collapsed" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontFamily="{DynamicResource Rayzer.Font.Icons}" Text="{DynamicResource Rayzer.Icon.Check}"
                         Foreground="{DynamicResource Rayzer.Text.OnBrand}" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Rayzer.Brand.Primary}" />
              <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Rayzer.Brand.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Rayzer.Focus}" />
              <Setter TargetName="Caixa" Property="BorderThickness" Value="2.5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== Botão de opção =====
    Sem este estilo o WPF usava a cor padrão do Windows (preta): "Demonstração / Ao vivo" do
    gêmeo ficava ilegível no tema escuro — justo o controle que diz se o desenho é simulação
    ou a catraca real (docs/34 §7.1, P1). Mesmo desenho da caixa de marcar, em círculo.
  -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <Ellipse x:Name="Aro" StrokeThickness="1.5" Stroke="{DynamicResource Rayzer.Input.Border}" Fill="{DynamicResource Rayzer.Input.Background}" />
              <Ellipse x:Name="Ponto" Width="10" Height="10" Visibility="Collapsed" Fill="{DynamicResource Rayzer.Brand.Primary}" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Rayzer.Brand.Primary}" />
              <Setter TargetName="Ponto" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Rayzer.Brand.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Rayzer.Focus}" />
              <Setter TargetName="Aro" Property="StrokeThickness" Value="2.5" />
            </Trigger>
            <!-- Desabilitado com cor própria, como os botões (P12): nada de opacidade. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Rayzer.Text.Disabled}" />
              <Setter TargetName="Aro" Property="Fill" Value="{DynamicResource Rayzer.Surface.Disabled}" />
              <Setter TargetName="Ponto" Property="Fill" Value="{DynamicResource Rayzer.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Barra de rolagem fina ===== -->
  <Style x:Key="Rayzer.ScrollBar.Page" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Rayzer.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Polegar" Margin="2" CornerRadius="4" Background="{DynamicResource Rayzer.Scrollbar.Thumb}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Polegar" Property="Background" Value="{DynamicResource Rayzer.Text.Secondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Rayzer.ScrollBar.Page}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Rayzer.ScrollBar.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Rayzer.ScrollBar.Page}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Rayzer.ScrollBar.Page}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource Rayzer.ScrollBar.Thumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Rayzer.ScrollBar.Page}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Tabela ===== -->
  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource Rayzer.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowHeight" Value="{DynamicResource Rayzer.Height.Row}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Small}" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="ColumnHeaderHeight" Value="36" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Sunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Hover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Selected}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== Lista (ListBox) =====
    Sem estilo, a lista de peças do gêmeo saía branca no tema escuro: um bloco ofuscante numa
    sala escura (docs/34 §7.1, P2). Tem o aspecto de campo, como a caixa de seleção ao lado:
    fundo e borda de campo, itens com a altura da linha de tabela (alvo de toque de 36 px) e
    a mesma seleção da caixa de seleção. O menu lateral usa estilos com chave e não é afetado.
  -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Input.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border x:Name="Borda" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Rayzer.Radius.Sm}"
                  SnapsToDevicePixels="True">
            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Borda" Property="Background" Value="{DynamicResource Rayzer.Surface.Disabled}" />
              <Setter TargetName="Borda" Property="BorderBrush" Value="{DynamicResource Rayzer.Surface.Disabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="MinHeight" Value="{DynamicResource Rayzer.Height.Row}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Fundo" Background="Transparent" CornerRadius="{DynamicResource Rayzer.Radius.Sm}" Padding="{TemplateBinding Padding}"
                  BorderThickness="2" BorderBrush="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <!-- A borda de 2 px existe sempre, transparente: o foco só a pinta, sem mexer no texto. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource Rayzer.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Menu lateral ===== -->
  <Style x:Key="Rayzer.Nav.List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
  </Style>

  <Style x:Key="Rayzer.Nav.Item" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Fundo" Margin="8,2" MinHeight="{DynamicResource Rayzer.Height.Touch}" Background="Transparent"
                  CornerRadius="{DynamicResource Rayzer.Radius.Md}" BorderThickness="0" BorderBrush="{DynamicResource Rayzer.Focus}">
            <Grid>
              <!-- A linha do fluxo: marca o item ativo. -->
              <Border x:Name="Indicador" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="2"
                      Background="{DynamicResource Rayzer.Nav.Indicator}" Visibility="Collapsed" />
              <ContentPresenter Margin="14,0" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Nav.Item.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text.Active}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Nav.Item.Active}" />
              <Setter TargetName="Indicador" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Nav.Text.Active}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fundo" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Passos do assistente (abas à esquerda) ===== -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel IsItemsHost="True" Margin="0,0,16,0" KeyboardNavigation.TabIndex="1" />
            <Border Grid.Column="1" Style="{StaticResource Rayzer.Card}" Padding="8">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Fundo" Margin="0,0,0,4" MinHeight="{DynamicResource Rayzer.Height.Touch}" Padding="16,0"
                  Background="Transparent" CornerRadius="{DynamicResource Rayzer.Radius.Md}"
                  BorderThickness="0" BorderBrush="{DynamicResource Rayzer.Focus}">
            <Grid>
              <Border x:Name="Indicador" Width="3" HorizontalAlignment="Left" Margin="-10,10,0,10" CornerRadius="2"
                      Background="{DynamicResource Rayzer.Brand.Primary}" Visibility="Collapsed" />
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Rayzer.Brand.Primary.Subtle}" />
              <Setter TargetName="Indicador" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Rayzer.Brand.Primary.Foreground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fundo" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Dica ===== -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Rayzer.Surface.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Rayzer.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rayzer.Border}" />
    <Setter Property="FontSize" Value="{DynamicResource Rayzer.FontSize.Small}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Margin="0,0,8,8" Padding="10,6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource Rayzer.Radius.Md}" Effect="{DynamicResource Rayzer.Shadow.Sm}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
