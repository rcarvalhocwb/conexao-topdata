<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Log estruturado, métricas e redação de dado sensível.
    Sem dependências externas de propósito: é carregado por todos os processos,
    inclusive o worker x86, onde cada dependência a mais é uma chance a mais de
    incompatibilidade.
  -->
  <PropertyGroup>
    <!-- CA1716: 'Shared' é palavra reservada no Visual Basic. O nome vem da estrutura
         de solução documentada em docs/03-arquitetura.md e a solução é só C#; renomear
         custaria divergência entre o repositório e o documento sem ganho real. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

</Project>
