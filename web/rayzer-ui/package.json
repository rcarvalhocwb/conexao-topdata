{
  "name": "@rayzer/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Rayzer UI — o Rayzer Design System em React, TypeScript e Tailwind. Mesmos tokens e componentes do Rayzer XAcess desktop (src/Rayzer.Design).",
  "license": "UNLICENSED",
  "author": "Rayzer Serviços e Tecnologia LTDA",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/rayzer.css",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./fonts.css": "./src/tokens/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts --port 4173 --strictPort"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0"
  }
}
